# Leave empty to use same-origin /api through the Vite Gateway proxy.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_WORKSPACE_NAME=DWP Workspace
# Emergency frontend off-switch for advanced Home Studio code. Tenant eligibility still comes
# from the server-resolved Home capability response.
VITE_HOME_PERSONALIZATION_V2_ENABLED=false
# Frontend discovery preview for the built-in Home item library. This is not an authorization
# boundary and does not enable dynamic Provider definitions or Tenant widget policy mutation.
VITE_HOME_WIDGET_LIBRARY_ENABLED=false
# Optional same-origin collector. Payloads contain metric and route group only, never user data.
VITE_WEB_VITALS_ENDPOINT=
VITE_PRODUCT_SURFACE_TELEMETRY_COLLECTION=false
# Transport/UI gate only. Keep OFF until the tenant rollout and Payroll owner v48 authority are
# installed together; server-side authorization remains mandatory when this is ON.
VITE_HRIS_PAYROLL_SETTINGS_FOUNDATION_ENABLED=false
