{
  "npmScope": "dwp-frontend",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.{spec,test}.{ts,tsx,js,jsx}"],
    "sharedGlobals": ["{workspaceRoot}/package.json", "{workspaceRoot}/yarn.lock"],
    "productRuntime": [
      "production",
      "sharedGlobals",
      "{workspaceRoot}/apps/product-runtime/**/*",
      "{workspaceRoot}/apps/dwp/src/app.tsx",
      "{workspaceRoot}/apps/dwp/src/bootstrap-application.tsx",
      "{workspaceRoot}/apps/dwp/src/vite-env.d.ts",
      "{workspaceRoot}/apps/dwp/src/components/**/*",
      "{workspaceRoot}/apps/dwp/src/layouts/**/*",
      "{workspaceRoot}/apps/dwp/src/observability/**/*",
      "{workspaceRoot}/apps/dwp/src/providers/**/*",
      "{workspaceRoot}/apps/dwp/src/routes/components/**/*",
      "{workspaceRoot}/apps/dwp/src/routes/configured-product-surface-shell.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/draft-product-dynamic-page-routes.ts",
      "{workspaceRoot}/apps/dwp/src/routes/draft-product-page-route-contract-source.ts",
      "{workspaceRoot}/apps/dwp/src/routes/governed-route-access-guard.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/official-product-page-route-contracts.ts",
      "{workspaceRoot}/apps/dwp/src/routes/product-canary-access-state.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/product-canary-first-allowed-index-runtime.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/product-canary-index-resolution.ts",
      "{workspaceRoot}/apps/dwp/src/routes/product-canary-root-runtime.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/product-route-contract-source.ts",
      "{workspaceRoot}/apps/dwp/src/routes/product-surface-authorization.generated.ts",
      "{workspaceRoot}/apps/dwp/src/routes/product-surface-canary-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/product-surface-guard.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/route-support.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/two-surface-product-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/features/auth/**/*",
      "{workspaceRoot}/apps/dwp/src/features/saved-views/**/*",
      "{workspaceRoot}/apps/dwp/src/features/search/**/*",
      "{workspaceRoot}/apps/dwp/src/features/shell/**/*",
      "{workspaceRoot}/libs/**/*",
      "{workspaceRoot}/public/**/*",
      "{workspaceRoot}/architecture/frontend-apps.json",
      "{workspaceRoot}/architecture/product-page-routes.v1.json",
      "{workspaceRoot}/architecture/product-surface-authorization.v1.json",
      "{workspaceRoot}/scripts/build-product-app.mjs",
      "{workspaceRoot}/scripts/check-bundle-budget.mjs",
      "{workspaceRoot}/scripts/product-bundle-budgets.json",
      "{workspaceRoot}/vite.product.config.ts",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json"
    ],
    "workspaceProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/activity-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/notification-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/work-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/workspace-application-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/workspace-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/{home,work,activity,apps,notifications}.tsx",
      "{workspaceRoot}/apps/dwp/src/features/{home,work-hub,work,activity,notifications}/**/*"
    ],
    "dwaionProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/dwaion-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/dwaion.tsx",
      "{workspaceRoot}/apps/dwp/src/layouts/dwaion-layout.tsx",
      "{workspaceRoot}/apps/dwp/src/features/dwaion/**/*"
    ],
    "hcmProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/hcm-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/hcm.tsx",
      "{workspaceRoot}/apps/dwp/src/features/{hcm,people,workforce}/**/*"
    ],
    "approvalsProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/approval-surface-shell.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/approvals-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/approvals.tsx",
      "{workspaceRoot}/apps/dwp/src/features/approvals/**/*"
    ],
    "spacesProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/spaces-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/spaces.tsx",
      "{workspaceRoot}/apps/dwp/src/features/spaces/**/*"
    ],
    "calendarProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/calendar-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/calendar.tsx",
      "{workspaceRoot}/apps/dwp/src/features/calendar/**/*"
    ],
    "roomsProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/rooms-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/rooms.tsx",
      "{workspaceRoot}/apps/dwp/src/features/rooms/**/*"
    ],
    "mailProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/mail-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/mail.tsx",
      "{workspaceRoot}/apps/dwp/src/features/mail/**/*"
    ],
    "messagingProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/messaging-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/messaging.tsx",
      "{workspaceRoot}/apps/dwp/src/layouts/messaging-layout.tsx",
      "{workspaceRoot}/apps/dwp/src/features/messaging/**/*"
    ],
    "meetingsProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/meetings-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/meetings.tsx",
      "{workspaceRoot}/apps/dwp/src/layouts/meetings-layout.tsx",
      "{workspaceRoot}/apps/dwp/src/features/meetings/**/*"
    ],
    "communicationsProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/communications-canary-surface-shell.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/communications-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/communications.tsx",
      "{workspaceRoot}/apps/dwp/src/features/communications/**/*"
    ],
    "servicesProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/services-canary-surface-shell.tsx",
      "{workspaceRoot}/apps/dwp/src/routes/services-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/services.tsx",
      "{workspaceRoot}/apps/dwp/src/features/services/**/*"
    ],
    "administrationProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/administration-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/admin.tsx",
      "{workspaceRoot}/apps/dwp/src/features/{admin,integrations,spaces}/**/*"
    ],
    "providerProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/provider-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/provider.tsx",
      "{workspaceRoot}/apps/dwp/src/features/provider/**/*"
    ],
    "accountProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/account-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/account/**/*",
      "{workspaceRoot}/apps/dwp/src/features/account/**/*"
    ],
    "platformShellProduct": [
      "productRuntime",
      "{workspaceRoot}/apps/dwp/src/routes/platform-routes.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/{sign-in,page-403,page-not-found,status-page}.tsx",
      "{workspaceRoot}/apps/dwp/src/pages/auth/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}
