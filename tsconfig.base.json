{
  "compilerOptions": {
    /* Bundler */
    "baseUrl": ".",
    "module": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,

    /* Build */
    "target": "ES2020",
    "lib": ["ES2020", "ES2021.Intl", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,

    /* Workspace paths */
    "paths": {
      "@dwp-frontend/design-system": ["libs/design-system/src/index.ts"],
      "@dwp-frontend/design-system/*": ["libs/design-system/src/*"],
      "@dwp-frontend/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@dwp-frontend/shared-utils/*": ["libs/shared-utils/src/*"],
      "@dwp-frontend/shared-i18n": ["libs/shared-i18n/src/index.ts"],
      "@dwp-frontend/shared-i18n/*": ["libs/shared-i18n/src/*"]
    },

    /* Linting */
    "strict": true,
    "noEmit": true,
    "strictNullChecks": true
  }
}
