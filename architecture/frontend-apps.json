{
  "schemaVersion": 1,
  "composition": "same-origin-route",
  "gatewayPrefix": "/api",
  "assetBaseTemplate": "/assets/dwp/{applicationId}/",
  "shell": {
    "id": "platform-shell",
    "routePrefixes": ["/sign-in", "/activate", "/auth/oidc", "/403", "/404"],
    "deployment": "independent"
  },
  "applications": [
    {
      "id": "workspace",
      "features": ["home", "work-hub", "work", "activity"],
      "routePrefixes": ["/", "/work", "/activity", "/apps"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "dwaion",
      "features": ["dwaion"],
      "routePrefixes": ["/dwaion", "/ask"],
      "backendServices": ["agent", "platform"],
      "deployment": "independent"
    },
    {
      "id": "hcm",
      "features": ["hcm", "people", "workforce"],
      "routePrefixes": ["/hr", "/people", "/workforce"],
      "backendServices": ["people", "platform"],
      "deployment": "independent"
    },
    {
      "id": "approvals",
      "features": ["approvals"],
      "routePrefixes": ["/approvals"],
      "backendServices": ["approval"],
      "deployment": "independent"
    },
    {
      "id": "spaces",
      "features": ["spaces"],
      "routePrefixes": ["/spaces"],
      "backendServices": ["space", "approval", "auth"],
      "deployment": "independent"
    },
    {
      "id": "calendar",
      "features": ["calendar"],
      "routePrefixes": ["/calendar"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "rooms",
      "features": ["rooms"],
      "routePrefixes": ["/workplace", "/rooms"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "mail",
      "features": ["mail"],
      "routePrefixes": ["/mail"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "messaging",
      "features": ["messaging"],
      "routePrefixes": ["/messages"],
      "backendServices": ["messaging", "space", "auth"],
      "deployment": "independent"
    },
    {
      "id": "communications",
      "features": ["communications"],
      "routePrefixes": ["/communications"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "services",
      "features": ["services"],
      "routePrefixes": ["/services"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "administration",
      "features": ["admin", "integrations"],
      "routePrefixes": ["/admin"],
      "backendServices": ["auth", "people", "platform", "provider", "space"],
      "deployment": "independent"
    },
    {
      "id": "provider",
      "features": ["provider"],
      "routePrefixes": ["/provider"],
      "backendServices": ["provider"],
      "deployment": "independent"
    },
    {
      "id": "account",
      "features": ["account"],
      "routePrefixes": ["/account"],
      "backendServices": ["auth", "platform"],
      "deployment": "independent"
    }
  ],
  "platformFeatures": ["auth", "notifications", "saved-views", "search", "shell"],
  "governedProductSurfaces": [
    {
      "productId": "approvals",
      "applicationId": "approvals",
      "routePrefix": "/approvals",
      "workSurfaceIds": ["approvals.work"],
      "managementSurfaceIds": ["approvals.admin"],
      "migrationWave": "W1a",
      "rolloutDefault": "000"
    },
    {
      "productId": "communications",
      "applicationId": "communications",
      "routePrefix": "/communications",
      "workSurfaceIds": ["communications.work"],
      "managementSurfaceIds": ["communications.management"],
      "migrationWave": "W0.5",
      "rolloutDefault": "000"
    },
    {
      "productId": "services",
      "applicationId": "services",
      "routePrefix": "/services",
      "workSurfaceIds": ["services.work"],
      "managementSurfaceIds": ["services.management"],
      "migrationWave": "W0.5",
      "rolloutDefault": "000"
    },
    {
      "productId": "hcm",
      "applicationId": "hcm",
      "routePrefix": "/hr",
      "workSurfaceIds": ["hcm.personal", "hcm.team"],
      "managementSurfaceIds": ["hcm.operations", "hcm.management"],
      "migrationWave": "W1b",
      "rolloutDefault": "000"
    },
    {
      "productId": "dwaion",
      "applicationId": "dwaion",
      "routePrefix": "/dwaion",
      "workSurfaceIds": ["dwaion.work"],
      "managementSurfaceIds": ["dwaion.management"],
      "migrationWave": "W2",
      "rolloutDefault": "000"
    },
    {
      "productId": "notifications",
      "platformFeature": "notifications",
      "routeModule": "notification-routes.tsx",
      "routePrefix": "/notifications",
      "workSurfaceIds": ["notifications.work"],
      "managementSurfaceIds": ["notifications.management"],
      "migrationWave": "W2",
      "rolloutDefault": "000"
    },
    {
      "productId": "spaces",
      "applicationId": "spaces",
      "routePrefix": "/spaces",
      "workSurfaceIds": ["spaces.work"],
      "managementSurfaceIds": ["spaces.management"],
      "migrationWave": "W2",
      "rolloutDefault": "000"
    },
    {
      "productId": "calendar",
      "applicationId": "calendar",
      "routePrefix": "/calendar",
      "workSurfaceIds": ["calendar.work"],
      "managementSurfaceIds": ["calendar.management"],
      "migrationWave": "W3",
      "rolloutDefault": "000"
    },
    {
      "productId": "workplace",
      "applicationId": "rooms",
      "routePrefix": "/workplace",
      "workSurfaceIds": ["workplace.work"],
      "managementSurfaceIds": ["workplace.management"],
      "migrationWave": "W3",
      "rolloutDefault": "000"
    },
    {
      "productId": "mail",
      "applicationId": "mail",
      "routePrefix": "/mail",
      "workSurfaceIds": ["mail.work"],
      "managementSurfaceIds": ["mail.management"],
      "migrationWave": "W3",
      "rolloutDefault": "000"
    },
    {
      "productId": "messaging",
      "applicationId": "messaging",
      "routePrefix": "/messages",
      "workSurfaceIds": ["messaging.work"],
      "managementSurfaceIds": ["messaging.management"],
      "migrationWave": "W3",
      "rolloutDefault": "000"
    }
  ]
}
