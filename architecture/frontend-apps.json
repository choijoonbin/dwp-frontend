{
  "schemaVersion": 1,
  "composition": "same-origin-route",
  "gatewayPrefix": "/api",
  "assetBaseTemplate": "/assets/dwp/{applicationId}/",
  "shell": {
    "id": "platform-shell",
    "routePrefixes": ["/sign-in", "/activate", "/auth/oidc", "/403", "/404"],
    "deployment": "independent"
  },
  "applications": [
    {
      "id": "workspace",
      "features": ["home", "home-personalization", "work-hub", "work", "activity"],
      "routePrefixes": ["/", "/work", "/activity", "/apps"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "dwaion",
      "features": ["dwaion"],
      "routePrefixes": ["/dwaion", "/ask"],
      "backendServices": ["agent", "platform"],
      "deployment": "independent"
    },
    {
      "id": "hcm",
      "features": ["hcm", "people", "workforce"],
      "routePrefixes": ["/hr", "/people", "/workforce"],
      "backendServices": ["people", "platform"],
      "deployment": "independent"
    },
    {
      "id": "approvals",
      "features": ["approvals"],
      "routePrefixes": ["/approvals"],
      "backendServices": ["approval"],
      "deployment": "independent"
    },
    {
      "id": "spaces",
      "features": ["spaces"],
      "routePrefixes": ["/spaces"],
      "backendServices": ["space", "approval", "auth"],
      "deployment": "independent"
    },
    {
      "id": "calendar",
      "features": ["calendar"],
      "routePrefixes": ["/calendar"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "rooms",
      "features": ["rooms"],
      "routePrefixes": ["/workplace", "/rooms"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "mail",
      "features": ["mail"],
      "routePrefixes": ["/mail"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "messaging",
      "features": ["messaging"],
      "routePrefixes": ["/messages"],
      "backendServices": ["messaging", "space", "auth"],
      "deployment": "independent"
    },
    {
      "id": "communications",
      "features": ["communications"],
      "routePrefixes": ["/communications"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "services",
      "features": ["services"],
      "routePrefixes": ["/services"],
      "backendServices": ["platform"],
      "deployment": "independent"
    },
    {
      "id": "administration",
      "features": ["admin", "integrations"],
      "routePrefixes": ["/admin"],
      "backendServices": ["auth", "people", "platform", "provider", "space"],
      "deployment": "independent"
    },
    {
      "id": "provider",
      "features": ["provider"],
      "routePrefixes": ["/provider"],
      "backendServices": ["provider"],
      "deployment": "independent"
    },
    {
      "id": "account",
      "features": ["account"],
      "routePrefixes": ["/account"],
      "backendServices": ["auth", "platform"],
      "deployment": "independent"
    }
  ],
  "platformFeatures": ["auth", "notifications", "saved-views", "search", "shell"]
}
