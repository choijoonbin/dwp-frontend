{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/architecture/product-surface-production-readiness.schema.json",
  "title": "DWP Product Surface Production Readiness Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestId",
    "release",
    "asOf",
    "status",
    "adrReference",
    "navigationConveniencePolicy",
    "scopedJitReleasePolicy",
    "productionGates",
    "decisions",
    "products",
    "exitCriteria"
  ],
  "properties": {
    "$schema": {
      "const": "../../../architecture/product-surface-production-readiness.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "manifestId": { "const": "product-surface-production-readiness.v1" },
    "release": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "enum": ["READY", "BLOCKED"] },
    "adrReference": { "$ref": "#/$defs/repositoryPath" },
    "navigationConveniencePolicy": { "$ref": "#/$defs/navigationConveniencePolicy" },
    "scopedJitReleasePolicy": { "$ref": "#/$defs/scopedJitReleasePolicy" },
    "productionGates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/readinessItem" }
    },
    "decisions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/readinessItem" }
    },
    "products": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/productClosure" }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/readinessItem" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"
    },
    "state": {
      "enum": ["COMPLETE", "PENDING_INTERNAL", "BLOCKED_EXTERNAL"]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedAt"],
      "properties": {
        "approvedBy": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "owner", "recordedAt", "reference", "checksum", "provenance"],
      "properties": {
        "type": {
          "enum": [
            "OWNER_APPROVAL",
            "OPENAPI",
            "CONTRACT_CHECKSUM",
            "ROLLBACK_REHEARSAL",
            "AUTOMATED_TEST_RUN",
            "PRIVACY_APPROVAL",
            "ACCESSIBILITY_MANUAL_AT",
            "PAGE_CONTRACT",
            "DATA_CONTRACT",
            "ACTION_CONTRACT",
            "GATEWAY_PEP_TEST",
            "SERVICE_PEP_TEST",
            "CROSS_TENANT_NEGATIVE_TEST",
            "DEPLOYMENT_TRUST_ATTESTATION",
            "ARTIFACT_ROUTING_MATRIX",
            "REVOCATION_SLO",
            "TELEMETRY_RETENTION",
            "USABILITY_STUDY",
            "CHAOS_TEST",
            "PENETRATION_TEST",
            "FEATURE_DISABLED_AT_RELEASE"
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:https://|[A-Za-z0-9_.-]+/).+"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provenance": { "$ref": "#/$defs/evidenceProvenance" }
      }
    },
    "evidenceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim",
        "issuer",
        "sourceRevision",
        "attestationReference",
        "attestationChecksum"
      ],
      "properties": {
        "kind": {
          "enum": [
            "OWNER_APPROVAL_ATTESTATION",
            "REVIEWED_ARTIFACT_ATTESTATION",
            "AUTOMATED_RUN_ATTESTATION",
            "DEPLOYMENT_ATTESTATION",
            "INDEPENDENT_REVIEW_ATTESTATION"
          ]
        },
        "claim": { "$ref": "#/$defs/evidence/properties/type" },
        "issuer": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "attestationReference": { "type": "string", "pattern": "^https://.+" },
        "attestationChecksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "readinessItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "state",
        "releaseRequired",
        "summary",
        "requiredEvidenceTypes",
        "approval",
        "evidence",
        "blockers",
        "failClosedEvidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "releaseRequired": { "const": true },
        "summary": { "type": "string", "minLength": 1 },
        "requiredEvidenceTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence/properties/type" },
          "uniqueItems": true
        },
        "approval": { "$ref": "#/$defs/approval" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(INTERNAL|EXTERNAL)_[A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "failClosedEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/repositoryPath" },
          "uniqueItems": true
        },
        "productId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "routeKinds": { "const": ["PAGE", "DATA", "ACTION"] },
        "rolloutDefault": { "const": "000" }
      }
    },
    "productClosure": {
      "allOf": [
        { "$ref": "#/$defs/readinessItem" },
        {
          "type": "object",
          "required": ["productId", "routeKinds", "rolloutDefault"],
          "properties": {
            "productId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "routeKinds": {
              "const": ["PAGE", "DATA", "ACTION"]
            },
            "rolloutDefault": { "const": "000" }
          }
        }
      ]
    },
    "navigationConveniencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "workReturnLastRoute",
        "managementAutomaticRestore",
        "managementResume",
        "acceptanceCriteria"
      ],
      "properties": {
        "policyId": { "const": "product-surface-navigation-convenience.v1" },
        "workReturnLastRoute": { "const": "ALLOWED" },
        "managementAutomaticRestore": { "const": "FORBIDDEN" },
        "managementResume": { "const": "EXPLICIT_USER_ACTION_AND_REAUTHORIZE_ONLY" },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "requirement", "testReference"],
            "properties": {
              "id": { "type": "string", "pattern": "^NC-0[1-5]$" },
              "requirement": { "type": "string", "minLength": 1 },
              "testReference": { "$ref": "#/$defs/repositoryPath" }
            }
          }
        }
      }
    },
    "scopedJitReleasePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "activation",
        "environmentOverride",
        "allowedScopes",
        "controlIds",
        "reenablementRequirements"
      ],
      "properties": {
        "policyId": { "const": "scoped-jit-release-disablement.v1" },
        "activation": { "const": "DISABLED" },
        "environmentOverride": { "const": "FORBIDDEN" },
        "allowedScopes": { "const": [] },
        "controlIds": {
          "const": [
            "AUTH_SERVICE_ROLLOUT_GATE",
            "DB_POLICY_MODE_TRIGGER",
            "DB_REQUEST_STATE_TRIGGER",
            "DB_ACTIVE_GRANT_TRIGGER"
          ]
        },
        "reenablementRequirements": {
          "const": [
            "EXACT_SCOPE_PEP",
            "EXPIRY_REVALIDATION",
            "AUTHORITY_REVISION_BINDING",
            "CROSS_SCOPE_NEGATIVE_MATRIX",
            "IDENTITY_SECURITY_OWNER_APPROVAL"
          ]
        }
      }
    }
  }
}
