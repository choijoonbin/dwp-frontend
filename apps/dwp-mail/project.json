{
  "name": "dwp-mail",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/product-runtime/src",
  "tags": ["scope:mail", "type:product", "runtime:browser", "deployment:independent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["mailProduct"],
      "options": {
        "command": "node scripts/build-product-app.mjs mail"
      },
      "outputs": ["{workspaceRoot}/dist/apps/mail"]
    }
  }
}
