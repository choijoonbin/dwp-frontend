{
  "name": "dwp-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/product-runtime/src",
  "tags": ["scope:workspace", "type:product", "runtime:browser", "deployment:independent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["workspaceProduct"],
      "options": {
        "command": "node scripts/build-product-app.mjs workspace"
      },
      "outputs": ["{workspaceRoot}/dist/apps/workspace"]
    }
  }
}
