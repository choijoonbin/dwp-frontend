{
  "name": "dwp-platform-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/product-runtime/src",
  "tags": ["scope:platform", "type:shell", "runtime:browser", "deployment:independent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["platformShellProduct"],
      "options": {
        "command": "node scripts/build-product-app.mjs platform-shell"
      },
      "outputs": ["{workspaceRoot}/dist/apps/platform-shell"]
    }
  }
}
