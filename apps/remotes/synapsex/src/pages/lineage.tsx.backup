const mockVendorMasterSnapshots = {
  transaction: {
    timestamp: '2026-01-28T14:00:00Z',
    data: {
      vendorId: 'V-10001',
      vendorName: 'Vendor Alpha Inc',
      bankAccount: 'DE89370400440532013000',
      bankName: 'Deutsche Bank',
