{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dwp.hris.scoped-g3-preflight-receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "receiptId",
    "packetId",
    "packetFileSha256",
    "sessionId",
    "observedAt",
    "checks",
    "blockers",
    "result",
    "startCommandIssued",
    "developmentStarted",
    "receiptPayloadSha256"
  ],
  "properties": {
    "schema": {"const": "dwp.hris.scoped-g3-preflight-receipt.v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "packetId": {"type": "string", "minLength": 1},
    "packetFileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessionId": {"enum": ["HRIS-HRM", "HRIS-PER", "HRIS-PAY", "HRIS-TIM", "HRIS-SYS"]},
    "observedAt": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 1},
    "blockers": {"type": "array"},
    "result": {"enum": ["PREFLIGHT_PASS_READY_TO_START_HOLD", "PREFLIGHT_FAIL"]},
    "startCommandIssued": {"const": false},
    "developmentStarted": {"const": false},
    "receiptPayloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
