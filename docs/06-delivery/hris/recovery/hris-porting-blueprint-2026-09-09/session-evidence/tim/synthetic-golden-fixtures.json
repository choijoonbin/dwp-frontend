      "layer": "GLOBAL_CORE",
      "input": {"zone":"America/New_York","start":"2026-03-08T01:30:00-05:00","end":"2026-03-08T03:30:00-04:00","breakMinutes":0},
      "expected": {"elapsedMinutes":60,"sourceOffsets":[-300,-240],"exceptionCodes":[]}
    },
    {
      "id": "TIM-GOLD-003",
      "title": "duplicate and out-of-order clock events are deterministic",
      "layer": "GLOBAL_CORE",
      "input": {"events":[{"key":"E1","type":"IN","at":"2026-02-10T09:00:00+09:00","receivedOrder":2},{"key":"E2","type":"OUT","at":"2026-02-10T18:00:00+09:00","receivedOrder":1},{"key":"E1","type":"IN","at":"2026-02-10T09:00:00+09:00","receivedOrder":3}]},
      "expected": {"acceptedEventKeys":["E1","E2"],"duplicateCount":1,"elapsedMinutes":540,"outputStableAfterReplay":true}
    },
    {
      "id": "TIM-GOLD-004",
      "title": "tenant-configured overtime threshold is not a legal default",
