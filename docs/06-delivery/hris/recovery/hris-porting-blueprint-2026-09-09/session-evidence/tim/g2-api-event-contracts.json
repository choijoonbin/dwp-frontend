    {"id":"handoff.query","method":"GET","path":"/v1/payroll-handoffs/{handoffId}","action":"TIME_PAYROLL_HANDOFF_VIEW","scope":"TIME_GROUP|PERIOD","mode":"query","response":"ClosedTimeResult.v1"},
    {"id":"insight.export","method":"POST","path":"/v1/insights/exports","action":"TIME_EXPORT","scope":"TIME_GROUP|PERIOD","mode":"command","idempotent":true,"stepUp":"required","fieldPolicy":"TIME_EXPORT","response":"TimeCommandReceipt.v1"}
