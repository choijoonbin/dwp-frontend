      "response": "ClosedTimeResult.v1",
      "responseRequired": ["closedTimeResultId","closePeriodId","closeRevision","payrollEntityId","payPeriodId","ledgerRevisionFrom","ledgerRevisionTo","workerCount","lineCount","sourceDigest","ruleDigest","payloadDigest","supersedesResultId","lines"],
      "lineRequired": ["workerId","assignmentId","payCode","unit","quantity","sourceEntryCount","sourceEntryDigest"],
      "rules": ["mTLS workload identity, signed tenant claim and owner tenant grant are mandatory","only immutable CLOSED results are returned and payloadDigest must verify","browser routing and caller-selected tenant are forbidden","superseded or reopened results fail closed"]
    },
    {
      "id": "home-contribution.internal.query",
      "method": "GET",
      "path": "/internal/hris-time/v1/home-contributions/{payloadRef}",
      "action": "approved SYS home projection contract",
      "callerWorkload": "dwp-platform-server",
      "purposeCode": "HRIS_HOME_MATERIALIZATION",
      "response": "TimeHomeContribution.v1",
      "requestContextRequired": ["subjectPrincipalPublicId","effectivePermissionRevision","populationScopeDigest","fieldPolicyRevision","widgetKey","browserAudience","ownerPopulationScope","scopeRevision","correlationId"],
      "responseRequired": ["module","widgetKey","widgetType","browserAudience","ownerPopulationScope","scopeRevision","populationScopeDigest","fieldPolicyRevision","purposeCode","state","generatedAt","freshUntil","staleAfter","deepLink","sourceVersion","payloadRef","payloadDigest","asOf","data","fieldDecisions","partialFailures"],
      "typedDataProfile": "TimeLeaveHomeData",
      "browserProjection": "dwp.hris.system.transport.v1#/$defs/HomeWidget",
      "rules": ["mTLS workload identity, signed tenant claim and owner tenant grant are mandatory","signed on-behalf-of subject context is mandatory and cannot be overridden by request body","widget capability, effective permission revision, population scope, purpose and field projection are re-evaluated","payloadRef is opaque and tenant-bound and payloadDigest is verified","data is the closed TimeLeaveHomeData profile; arbitrary JSON, location evidence, leave reasons and browser payloadRef are forbidden","SYS removes payloadRef and revalidates the widget discriminant, audience, scope revision, field-policy revision, freshness and deep link before browser serialization","browser routing and caller-selected tenant are forbidden"]
    }
