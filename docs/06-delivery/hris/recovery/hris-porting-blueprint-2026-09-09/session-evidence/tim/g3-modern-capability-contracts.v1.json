          "checks": [
            "status IN (CANDIDATE_GENERATED,VALIDATED,PENDING_APPROVAL,PUBLISHED,REJECTED)",
            "candidate_revision > 0",
            "candidate_digest <> ''"
          ],
          "indexes": [
            "(tenant_id,status,period_start)",
            "(tenant_id,demand_forecast_id,candidate_revision DESC)"
          ],
          "retentionClass": "WFM_PLANNING_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        },
        {
