          "stateMachineId": "MOD-TIM-WFM-SM-001",
          "aggregate": "WorkforceScheduleScenario",
          "initialState": "NONE",
          "terminalStates": [
            "PUBLISHED",
            "REJECTED"
          ],
          "transitions": [
            {
              "transitionId": "MOD-TIM-WFM-TR-001",
              "from": "NONE",
              "to": "FORECAST_DRAFT",
              "operationId": "modern.wfm.forecast.create",
              "guard": "demand source range timezone and source digest present"
            },
            {
              "transitionId": "MOD-TIM-WFM-TR-002",
              "from": "FORECAST_DRAFT|CANDIDATE_GENERATED",
              "to": "CANDIDATE_GENERATED",
              "operationId": "modern.wfm.schedule.optimize",
              "guard": "pinned demand availability skill and time-policy revisions; deterministic seed"
            },
            {
              "transitionId": "MOD-TIM-WFM-TR-003",
              "from": "CANDIDATE_GENERATED",
              "to": "VALIDATED",
              "operationId": "modern.wfm.schedule.validate",
              "guard": "coverage labor-rule and fairness constraints pass or explained exceptions recorded"
            },
            {
              "transitionId": "MOD-TIM-WFM-TR-004",
              "from": "VALIDATED",
              "to": "PENDING_APPROVAL",
              "operationId": "modern.wfm.schedule.submit",
              "guard": "candidate digest frozen and no blocking exception"
            },
            {
              "transitionId": "MOD-TIM-WFM-TR-005",
              "from": "PENDING_APPROVAL",
              "to": "PUBLISHED",
              "operationId": "modern.wfm.schedule.publish",
              "guard": "human approval receipt and current input revisions"
            }
          ]
        }
