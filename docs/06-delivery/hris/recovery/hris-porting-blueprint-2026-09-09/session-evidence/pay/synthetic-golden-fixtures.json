    {
      "id": "PAY-GOLD-014",
      "title": "decimal precision rounding stages and overflow are deterministic",
      "layer": "GLOBAL_CORE",
      "input": {
        "contract": "dwp.hris.decimal-value-types.v1",
        "pipeline": ["SOURCE_NORMALIZE", "FORMULA_DECLARED", "ELEMENT", "WORKER_RESULT", "SETTLEMENT_OR_STATUTORY"],
        "roundingCases": [
          {"mode":"HALF_UP","scale":2,"values":["1.005","-1.005"],"outputs":["1.01","-1.01"]},
          {"mode":"HALF_EVEN","scale":2,"values":["1.005","-1.005"],"outputs":["1.00","-1.00"]},
          {"mode":"DOWN","scale":2,"values":["1.009","-1.009"],"outputs":["1.00","-1.00"]},
          {"mode":"UP","scale":2,"values":["1.001","-1.001"],"outputs":["1.01","-1.01"]},
          {"mode":"FLOOR","scale":2,"values":["1.001","-1.001"],"outputs":["1.00","-1.01"]},
          {"mode":"CEILING","scale":2,"values":["1.001","-1.001"],"outputs":["1.01","-1.00"]},
          {"mode":"HALF_EVEN","scale":0,"values":["2.5","3.5","-2.5","-3.5"],"outputs":["2","4","-2","-4"]},
          {"mode":"HALF_UP","scale":4,"values":["1.23445","-1.23445"],"outputs":["1.2345","-1.2345"]}
        ],
        "typedWorkerEntries": [
          {"valueType":"MONEY","value":"123.456789","currency":"USD","expectedType":"InputAmount"},
          {"valueType":"RATE","value":"0.12345678","unit":"RATIO","expectedType":"RateDecimal"},
          {"valueType":"HOURS","value":"8.500000","unit":"HOUR","expectedType":"QuantityDecimal"},
          {"valueType":"NUMBER","value":"999.12345678","unit":"UNITLESS","expectedType":"CalculationDecimal"}
        ],
        "negativeZeroCases": ["-0", "-0.0", "-0.000000"],
        "invalidWireValues": ["1e3", "-2E-2", "+1.00", "01.00", " 1.00"],
        "invalidJsonNumbers": [1.25, -0.0],
        "overflowCases": {
          "InputAmount": "10000000000000.000000",
          "RateDecimal": "100000000000.00000000",
          "CalculationDecimal": "10000000000000000.00000000",
          "PostedMoney": "1000000000000000.0000"
        },
        "mismatchCases": [
          {"left":{"amount":"1.00","currency":"USD"},"right":{"amount":"1.00","currency":"KRW"},"expected":"CROSS_CURRENCY_FORBIDDEN"},
          {"left":{"quantity":"1.000000","unit":"HOUR"},"right":{"quantity":"1.000000","unit":"DAY"},"expected":"UNIT_MISMATCH"},
          {"unit":"AMOUNT","quantity":"10.000000","currency":null,"expected":"CURRENCY_REQUIRED"},
          {"unit":"HOUR","quantity":"10.000000","currency":"USD","expected":"CURRENCY_FORBIDDEN"}
        ],
        "trace": [
          {"stage":"SOURCE_NORMALIZE","before":"1.005000","after":"1.005","scale":6,"mode":"DOWN","policyDigest":"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"},
          {"stage":"ELEMENT","before":"1.005","after":"1.01","scale":2,"mode":"HALF_UP","policyDigest":"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"},
          {"stage":"WORKER_RESULT","before":"1.01","after":"1.0100","scale":4,"mode":"HALF_UP","policyDigest":"abababababababababababababababababababababababababababababababab"}
        ]
      },
      "expected": {
        "wireType": "STRING",
        "roundingCasesAllMatch": true,
        "floatingPointUsed": false,
        "databaseRoundingUsed": false,
        "traceHasBeforeAfterStageScaleModePolicyDigest": true,
        "negativeZeroOutputs": ["0", "0", "0"],
        "invalidWireOutcome": "SCHEMA_INVALID",
        "invalidJsonNumberOutcome": "WIRE_TYPE_REQUIRED",
        "overflowOutcome": "DECIMAL_OVERFLOW",
        "sameInputPolicyDigestByteIdentical": true,
        "mismatchOutcomes": ["CROSS_CURRENCY_FORBIDDEN", "UNIT_MISMATCH", "CURRENCY_REQUIRED", "CURRENCY_FORBIDDEN"]
      }
