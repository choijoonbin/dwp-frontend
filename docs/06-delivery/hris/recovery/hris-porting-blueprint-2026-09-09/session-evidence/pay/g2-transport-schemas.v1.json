    "PackIdPath": {"type":"object","additionalProperties":false,"properties":{"packId":{"$ref":"#/$defs/Uuid"}},"required":["packId"]},
    "CaseIdPath": {"type":"object","additionalProperties":false,"properties":{"caseId":{"$ref":"#/$defs/Uuid"}},"required":["caseId"]},
    "ReceiptIdPath": {"type":"object","additionalProperties":false,"properties":{"receiptId":{"$ref":"#/$defs/Uuid"}},"required":["receiptId"]},
    "CommandReceiptQuery": {"type":"object","additionalProperties":false,"properties":{},"required":[]},
    "RunWorkerPath": {"type":"object","additionalProperties":false,"properties":{"runId":{"$ref":"#/$defs/Uuid"},"workerId":{"$ref":"#/$defs/Uuid"}},"required":["runId","workerId"]},
    "QueryHeaders": {"type":"object","additionalProperties":false,"properties":{"Authorization":{"type":"string","pattern":"^Bearer .+$"},"X-Correlation-Id":{"$ref":"#/$defs/Uuid"},"X-Purpose-Code":{"type":"string","minLength":3,"maxLength":64}},"required":["Authorization","X-Correlation-Id","X-Purpose-Code"]},
    "CommandHeaders": {"type":"object","additionalProperties":false,"properties":{"Authorization":{"type":"string","pattern":"^Bearer .+$"},"Idempotency-Key":{"type":"string","minLength":16,"maxLength":128},"X-Correlation-Id":{"$ref":"#/$defs/Uuid"},"X-Purpose-Code":{"type":"string","minLength":3,"maxLength":64}},"required":["Authorization","Idempotency-Key","X-Correlation-Id","X-Purpose-Code"]},
    "CasCommandHeaders": {"type":"object","additionalProperties":false,"properties":{"Authorization":{"type":"string","pattern":"^Bearer .+$"},"Idempotency-Key":{"type":"string","minLength":16,"maxLength":128},"X-Correlation-Id":{"$ref":"#/$defs/Uuid"},"X-Purpose-Code":{"type":"string","minLength":3,"maxLength":64},"If-Match":{"type":"string","pattern":"^(W/)?\"[A-Za-z0-9._:-]+\"$"}},"required":["Authorization","Idempotency-Key","X-Correlation-Id","X-Purpose-Code","If-Match"]},
    "Problem": {"type":"object","additionalProperties":false,"properties":{"type":{"type":"string","format":"uri-reference"},"title":{"type":"string","minLength":1},"status":{"type":"integer","enum":[400,401,403,404,409,422,429,503]},"code":{"type":"string","enum":["SCHEMA_INVALID","AUTHENTICATION_REQUIRED","AUTHORIZATION_DENIED","TARGET_NOT_DISCLOSED","STALE_OR_STATE_CONFLICT","DOMAIN_RULE_REJECTED","RATE_LIMITED","RESULT_UNKNOWN"]},"correlationId":{"$ref":"#/$defs/Uuid"},"retryable":{"type":"boolean"},"currentVersion":{"type":"integer","minimum":0},"receiptId":{"$ref":"#/$defs/Uuid"}},"required":["type","title","status","code","correlationId","retryable"]},
