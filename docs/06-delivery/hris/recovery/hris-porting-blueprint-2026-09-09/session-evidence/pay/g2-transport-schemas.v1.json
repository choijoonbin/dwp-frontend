{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractId": "dwp.hris.payroll.transport.v1",
  "module": "PAY",
  "sourceContract": "g2-api-event-contracts.json",
  "implementation": "NOT_STARTED_G3",
  "production": "NOT_AUTHORIZED_G6",
  "constraints": {
    "identifier": "UUID public identifiers only",
    "money": "decimal-value-types.v1.json is authoritative: InputAmount 19,6; RateDecimal 19,8; QuantityDecimal 19,6; CalculationDecimal 24,8; PostedMoney 19,4; wire values are non-exponent decimal strings and PostgreSQL never performs implicit rounding",
    "time": "RFC3339 instants; ISO-8601 business dates; effective periods are [from,to)",
    "commands": "Idempotency-Key and durable receipt required; If-Match required exactly where source expectedVersion=true",
    "queries": "cursor binds tenant/policy/asOf/filter/fields/freshness; payroll projections are field-policy trimmed"
  },
  "decimalValueContract": {
    "ref": "../../coding-readiness/decimal-value-types.v1.json",
    "sha256": "8597640fa5cf5051cccc14fe4b83a4f179d54dfe36f0ffdaa319dc1149b5c6a6",
    "contractId": "dwp.hris.decimal-value-types.v1",
    "wireType": "STRING",
    "exponentNotation": "FORBIDDEN",
    "floatingPoint": "FORBIDDEN",
    "databaseRounding": "FORBIDDEN"
  },
  "$defs": {
    "Uuid": {"type":"string","format":"uuid","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "Date": {"type":"string","format":"date","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "Instant": {"type":"string","format":"date-time"},
    "Digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "CalculationDecimal": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,8})?$","x-valueType":"CalculationDecimal","x-sqlType":"NUMERIC(24,8)","x-authoritativePointer":"../../coding-readiness/decimal-value-types.v1.json#/valueTypes/CalculationDecimal"},
    "InputAmount": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]{0,12})(?:\\.[0-9]{1,6})?$","x-valueType":"InputAmount","x-sqlType":"NUMERIC(19,6)","x-authoritativePointer":"../../coding-readiness/decimal-value-types.v1.json#/valueTypes/InputAmount"},
    "RateDecimal": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]{0,10})(?:\\.[0-9]{1,8})?$","x-valueType":"RateDecimal","x-sqlType":"NUMERIC(19,8)","x-authoritativePointer":"../../coding-readiness/decimal-value-types.v1.json#/valueTypes/RateDecimal"},
    "QuantityDecimal": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]{0,12})(?:\\.[0-9]{1,6})?$","x-valueType":"QuantityDecimal","x-sqlType":"NUMERIC(19,6)","x-authoritativePointer":"../../coding-readiness/decimal-value-types.v1.json#/valueTypes/QuantityDecimal"},
    "PostedAmount": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]{0,14})(?:\\.[0-9]{1,4})?$","x-valueType":"PostedMoney","x-sqlType":"NUMERIC(19,4)","x-authoritativePointer":"../../coding-readiness/decimal-value-types.v1.json#/valueTypes/PostedMoney"},
    "CurrencyCode": {"type":"string","pattern":"^[A-Z]{3}$"},
    "PostedMoney": {"type":"object","additionalProperties":false,"properties":{"amount":{"$ref":"#/$defs/PostedAmount"},"currency":{"$ref":"#/$defs/CurrencyCode"}},"required":["amount","currency"]},
    "InputMoney": {"type":"object","additionalProperties":false,"properties":{"amount":{"$ref":"#/$defs/InputAmount"},"currency":{"$ref":"#/$defs/CurrencyCode"}},"required":["amount","currency"]},
