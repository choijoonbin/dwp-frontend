    "VersionedConfigCommand": {"type":"object","additionalProperties":false,"properties":{"configCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"effectiveFrom":{"$ref":"#/$defs/Date"},"effectiveTo":{"$ref":"#/$defs/Date"},"payrollEntityId":{"$ref":"#/$defs/Uuid"},"payGroupId":{"$ref":"#/$defs/Uuid"},"version":{"type":"integer","minimum":1},"payloadDigest":{"$ref":"#/$defs/Digest"}},"required":["configCode","effectiveFrom","payrollEntityId","payGroupId","version","payloadDigest"]},
    "ElementCommand": {"type":"object","additionalProperties":false,"properties":{"elementCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,31}$"},"name":{"type":"string","minLength":1,"maxLength":120},"valueType":{"type":"string","enum":["MONEY","NUMBER","RATE","HOURS"]},"currency":{"$ref":"#/$defs/CurrencyCode"},"scale":{"type":"integer","minimum":0,"maximum":8},"effectiveFrom":{"$ref":"#/$defs/Date"}},"required":["elementCode","name","valueType","scale","effectiveFrom"]},
    "FormulaCommand": {"type":"object","additionalProperties":false,"properties":{"formulaCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,31}$"},"expression":{"type":"string","minLength":1,"maxLength":20000},"returnType":{"type":"string","enum":["MONEY","NUMBER","RATE","BOOLEAN"]},"scale":{"type":"integer","minimum":0,"maximum":8},"rounding":{"type":"string","enum":["HALF_UP","HALF_EVEN","DOWN","UP","FLOOR","CEILING"]},"effectiveFrom":{"$ref":"#/$defs/Date"}},"required":["formulaCode","expression","returnType","scale","rounding","effectiveFrom"]},
    "SimulationCommand": {"type":"object","additionalProperties":false,"properties":{"asOf":{"$ref":"#/$defs/Instant"},"workerIds":{"type":"array","items":{"$ref":"#/$defs/Uuid"},"minItems":1,"maxItems":100,"uniqueItems":true},"inputOverrides":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"properties":{"elementCode":{"type":"string"},"value":{"type":"string","maxLength":100}},"required":["elementCode","value"]}}},"required":["asOf","workerIds","inputOverrides"]},
    "ActionCommand": {"type":"object","additionalProperties":false,"properties":{"reasonCode":{"type":"string","minLength":1,"maxLength":64},"approvalReceiptId":{"$ref":"#/$defs/Uuid"},"comment":{"type":"string","maxLength":1000}},"required":["reasonCode"]},
