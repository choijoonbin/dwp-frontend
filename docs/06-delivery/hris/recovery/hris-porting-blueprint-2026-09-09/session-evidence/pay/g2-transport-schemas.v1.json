    "HoursWorkerEntryCommand": {"type":"object","additionalProperties":false,"properties":{"workerId":{"$ref":"#/$defs/Uuid"},"assignmentId":{"$ref":"#/$defs/Uuid"},"elementCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,31}$"},"valueType":{"type":"string","const":"HOURS"},"value":{"$ref":"#/$defs/QuantityDecimal"},"unit":{"type":"string","const":"HOUR"},"currency":{"type":"null"},"effectiveDate":{"$ref":"#/$defs/Date"},"reasonCode":{"type":"string","minLength":1,"maxLength":64}},"required":["workerId","assignmentId","elementCode","valueType","value","unit","currency","effectiveDate","reasonCode"]},
    "NumberWorkerEntryCommand": {"type":"object","additionalProperties":false,"properties":{"workerId":{"$ref":"#/$defs/Uuid"},"assignmentId":{"$ref":"#/$defs/Uuid"},"elementCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,31}$"},"valueType":{"type":"string","const":"NUMBER"},"value":{"$ref":"#/$defs/CalculationDecimal"},"unit":{"type":"string","const":"UNITLESS"},"currency":{"type":"null"},"effectiveDate":{"$ref":"#/$defs/Date"},"reasonCode":{"type":"string","minLength":1,"maxLength":64}},"required":["workerId","assignmentId","elementCode","valueType","value","unit","currency","effectiveDate","reasonCode"]},
    "WorkerEntryCommand": {"oneOf":[{"$ref":"#/$defs/MoneyWorkerEntryCommand"},{"$ref":"#/$defs/RateWorkerEntryCommand"},{"$ref":"#/$defs/HoursWorkerEntryCommand"},{"$ref":"#/$defs/NumberWorkerEntryCommand"}],"x-valueTypeBinding":{"MONEY":{"valueType":"InputAmount","unit":"CURRENCY","currency":"REQUIRED_ISO_4217"},"RATE":{"valueType":"RateDecimal","unit":"RATIO","currency":"FORBIDDEN_NULL"},"HOURS":{"valueType":"QuantityDecimal","unit":"HOUR","currency":"FORBIDDEN_NULL"},"NUMBER":{"valueType":"CalculationDecimal","unit":"UNITLESS","currency":"FORBIDDEN_NULL"}}},
    "RunCommand": {"type":"object","additionalProperties":false,"properties":{"runType":{"type":"string","enum":["REGULAR","OFF_CYCLE","RETRO","CORRECTION"]},"payrollEntityId":{"$ref":"#/$defs/Uuid"},"payGroupId":{"$ref":"#/$defs/Uuid"},"payPeriodId":{"$ref":"#/$defs/Uuid"},"asOf":{"$ref":"#/$defs/Instant"},"inputSnapshotDigest":{"$ref":"#/$defs/Digest"}},"required":["runType","payrollEntityId","payGroupId","payPeriodId","asOf","inputSnapshotDigest"]},
