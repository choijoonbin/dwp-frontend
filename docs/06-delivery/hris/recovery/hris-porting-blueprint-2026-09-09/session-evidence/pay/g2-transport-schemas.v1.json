    "EvidenceCommand": {"type":"object","additionalProperties":false,"properties":{"objectRef":{"type":"string","pattern":"^obj_[A-Za-z0-9_-]{16,128}$"},"objectDigest":{"$ref":"#/$defs/Digest"},"classification":{"type":"string","enum":["CONFIDENTIAL","RESTRICTED"]},"purposeCode":{"type":"string","minLength":3,"maxLength":64}},"required":["objectRef","objectDigest","classification","purposeCode"]},
