          "snapshotRevision",
          "planId",
          "cycleId",
          "workerId",
          "assignmentId",
          "componentCode",
          "currency",
          "approvedAmount",
          "effectiveFrom",
          "effectiveTo",
          "approvalReceiptId",
          "sourceVersion",
          "payloadDigest"
        ],
        "projection": "dwp-payroll-server/ApprovedCompensationPlanSnapshotV1",
        "freshnessRule": "PAY blocks an input freeze when snapshot revision is stale, superseded, unapproved, outside effective range, tenant mismatched or digest mismatched",
        "replayRule": "GET read-idempotent; cache key tenantId:snapshotId:snapshotRevision:payloadDigest; event replay never duplicates an input row"
      },
      "invalidationEvent": {
        "name": "ApprovedCompensationPlanSnapshotPublished.v2",
