          "time",
          "tenantId",
          "aggregateType",
          "aggregateId",
          "aggregateSequence",
          "correlationId",
          "data"
        ],
      "payloadRequired": [
        "aggregateId",
        "fromState",
        "toState",
        "aggregateVersion",
        "occurredAt",
        "correlationId",
        "planId",
        "cycleId",
        "approvalRevision",
          "approvalReceiptId",
        "effectiveDate",
        "snapshotId",
        "lineCount",
        "snapshotRevision",
        "sourceVersion",
        "payloadDigest"
      ],
      "consumerAction": "dedupe the post-snapshot-commit v2 event; refetch exact snapshot through SVC-PEP-PER-001 using snapshotId and snapshotRevision; verify tenant, causal state/version/time/correlation, plan/cycle identity, approval revision/receipt, effective range, lineCount and payloadDigest; materialize append-only input; quarantine any mismatch. CompensationPlanApproved.v1 and CompensationPlanApprovalRecorded.v2 never trigger PAY; dual publish is forbidden."
      },
      "backendRoot": "dwp-payroll-server/src/main/java/com/dwp/services/payroll/input/compensationplan",
      "backendTestRoot": "dwp-payroll-server/src/test/java/com/dwp/services/payroll/input/compensationplan",
      "migrationFile": "dwp-payroll-server/src/main/resources/db/migration/V49__pay_modern_compensation_plan_input.sql",
      "physicalTableDefaults": {
        "tenantColumn": "tenant_id BIGINT NOT NULL",
        "internalId": "module-specific BIGSERIAL PRIMARY KEY; never exposed",
        "publicId": "public_id UUID NOT NULL; UNIQUE(tenant_id,public_id)",
    "rowSecurity": "ENABLE ROW LEVEL SECURITY; FORCE ROW LEVEL SECURITY; tenant predicate current_setting('dwp.tenant_id',true)::bigint; application role NOBYPASSRLS",
        "crossRuntimeRule": "no PER DB FK or repository import; only service-authenticated snapshot refetch plus event invalidation"
      },
      "tables": [
        {
          "name": "pay_compensation_plan_inputs",
          "kind": "IMMUTABLE_INPUT_LEDGER",
          "idColumn": "compensation_plan_input_id",
          "effectiveTime": "effective_from DATE NOT NULL; effective_to DATE NULL; half-open [from,to)",
          "immutability": "APPEND_ONLY_SUPERSESSION",
          "foreignKeyBoundaries": [
            "OPAQUE:snapshot_id->PER.ApprovedCompensationPlanSnapshot",
            "OPAQUE:worker_id->HRM.Worker",
            "OPAQUE:assignment_id->HRM.Assignment"
          ],
          "uniqueKeys": [
            "(tenant_id,snapshot_id,snapshot_revision,worker_id,component_code)",
            "(tenant_id,payload_digest)"
          ],
          "checks": [
            "snapshot_revision > 0",
            "approved_amount >= 0",
            "currency ~ '^[A-Z]{3}$'",
            "payload_digest <> ''",
            "effective_to IS NULL OR effective_to > effective_from"
          ],
          "indexes": [
            "(tenant_id,cycle_id,worker_id,effective_from)",
            "(tenant_id,snapshot_id,snapshot_revision DESC)"
          ],
          "retentionClass": "PAYROLL_INPUT_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        },
        {
          "name": "pay_input_snapshot_compensation_refs",
          "kind": "INPUT_SNAPSHOT_JOIN_LEDGER",
          "idColumn": "input_snapshot_compensation_ref_id",
          "effectiveTime": "recorded_at TIMESTAMPTZ NOT NULL",
          "immutability": "APPEND_ONLY",
          "foreignKeyBoundaries": [
            "LOCAL:(tenant_id,input_snapshot_id)->pay_input_snapshots",
            "LOCAL:(tenant_id,compensation_plan_input_id)->pay_compensation_plan_inputs"
          ],
          "uniqueKeys": [
            "(tenant_id,input_snapshot_id,compensation_plan_input_id)",
            "(tenant_id,input_snapshot_id,line_sequence)"
          ],
          "checks": [
            "line_sequence > 0",
            "line_digest <> ''"
          ],
          "indexes": [
            "(tenant_id,input_snapshot_id,line_sequence)"
          ],
          "retentionClass": "PAYROLL_INPUT_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        }
      ],
