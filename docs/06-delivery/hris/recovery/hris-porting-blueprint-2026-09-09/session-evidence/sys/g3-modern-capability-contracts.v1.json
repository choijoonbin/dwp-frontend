      "tables": [
        {
          "name": "sys_hris_listening_surveys",
          "kind": "AGGREGATE_ROOT",
          "idColumn": "listening_survey_id",
          "effectiveTime": "opens_at TIMESTAMPTZ NOT NULL; closes_at TIMESTAMPTZ NOT NULL",
          "immutability": "MUTABLE_WITH_VERSION_THEN_TERMINAL",
          "foreignKeyBoundaries": [
            "OPAQUE:audience_snapshot_id->HRM.Access",
            "OPAQUE:consent_policy_version_id->SYS.Config"
          ],
          "uniqueKeys": [
            "(tenant_id,survey_key,survey_version)",
            "(tenant_id,public_id)"
          ],
          "checks": [
            "status IN (DRAFT,PUBLISHED,CLOSED,ACTION_TRACKING,COMPLETED,CANCELLED)",
            "closes_at > opens_at",
            "anonymity_threshold >= 5"
          ],
          "indexes": [
            "(tenant_id,status,opens_at,closes_at)"
          ],
          "retentionClass": "EMPLOYEE_LISTENING_POLICY_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        },
        {
          "name": "sys_hris_listening_responses",
          "kind": "PROTECTED_RESPONSE_LEDGER",
          "idColumn": "listening_response_id",
          "effectiveTime": "submitted_at TIMESTAMPTZ NOT NULL; erase_after TIMESTAMPTZ NOT NULL",
          "immutability": "APPEND_ONLY_CRYPTO_ERASURE",
          "foreignKeyBoundaries": [
            "LOCAL:(tenant_id,listening_survey_id)->sys_hris_listening_surveys",
            "OPAQUE:response_token_hash->identity-separated token store"
          ],
          "uniqueKeys": [
            "(tenant_id,listening_survey_id,response_token_hash)",
            "(tenant_id,response_digest)"
          ],
          "checks": [
            "response_digest <> ''",
            "respondent_public_id IS NULL"
          ],
          "indexes": [
            "(tenant_id,listening_survey_id,submitted_at)",
            "(tenant_id,erase_after)"
          ],
          "retentionClass": "ANONYMOUS_SURVEY_RESPONSE_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        },
        {
          "name": "sys_hris_listening_cohort_results",
          "kind": "PRIVACY_SAFE_PROJECTION",
          "idColumn": "listening_cohort_result_id",
          "effectiveTime": "calculated_at TIMESTAMPTZ NOT NULL",
          "immutability": "APPEND_ONLY_SUPERSESSION",
          "foreignKeyBoundaries": [
            "LOCAL:(tenant_id,listening_survey_id)->sys_hris_listening_surveys",
            "OPAQUE:cohort_definition_id->HRM.Access"
          ],
          "uniqueKeys": [
            "(tenant_id,listening_survey_id,cohort_definition_id,projection_revision)",
            "(tenant_id,result_digest)"
          ],
          "checks": [
            "participant_count >= anonymity_threshold",
            "suppressed_count >= 0",
            "result_digest <> ''"
          ],
          "indexes": [
            "(tenant_id,listening_survey_id,projection_revision DESC)"
          ],
          "retentionClass": "ANONYMOUS_COHORT_RESULT_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        },
        {
          "name": "sys_hris_listening_actions",
          "kind": "ACTION_LEDGER",
          "idColumn": "listening_action_id",
          "effectiveTime": "due_at TIMESTAMPTZ NOT NULL; completed_at TIMESTAMPTZ",
          "immutability": "MUTABLE_WITH_VERSION_THEN_TERMINAL",
          "foreignKeyBoundaries": [
            "LOCAL:(tenant_id,listening_survey_id)->sys_hris_listening_surveys",
            "OPAQUE:owner_principal_id->Auth.Principal"
          ],
          "uniqueKeys": [
            "(tenant_id,listening_survey_id,action_key)",
            "(tenant_id,public_id)"
          ],
          "checks": [
            "status IN (OPEN,IN_PROGRESS,COMPLETED,CANCELLED)",
            "cohort_identity_exported = FALSE"
          ],
          "indexes": [
            "(tenant_id,owner_principal_id,status,due_at)"
          ],
          "retentionClass": "LISTENING_ACTION_AUDIT_RETENTION_POLICY_REF",
          "rowSecurity": "INHERIT_EXACT_DEFAULT"
        }
      ],
