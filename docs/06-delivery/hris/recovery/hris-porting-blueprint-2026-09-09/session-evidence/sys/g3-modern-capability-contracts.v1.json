      "stateMachines": [
        {
          "stateMachineId": "MOD-SYS-LISTEN-SM-001",
          "aggregate": "ListeningProgram",
          "initialState": "NONE",
          "terminalStates": [
            "COMPLETED",
            "CANCELLED"
          ],
          "transitions": [
            {
              "transitionId": "MOD-SYS-LISTEN-TR-001",
              "from": "NONE",
              "to": "DRAFT",
              "operationId": "modern.listening.survey.create",
              "guard": "purpose consent anonymity threshold and question schema valid"
            },
            {
              "transitionId": "MOD-SYS-LISTEN-TR-002",
              "from": "DRAFT",
              "to": "PUBLISHED",
              "operationId": "modern.listening.survey.publish",
              "guard": "audience snapshot and start/end window frozen"
            },
            {
              "transitionId": "MOD-SYS-LISTEN-TR-003",
              "from": "PUBLISHED",
              "to": "PUBLISHED",
              "operationId": "modern.listening.response.submit",
              "guard": "one tenant-bound response token per participant; identity separation enforced"
            },
            {
              "transitionId": "MOD-SYS-LISTEN-TR-004",
              "from": "PUBLISHED",
              "to": "CLOSED",
              "operationId": "modern.listening.survey.close",
              "guard": "end window reached or approved early-close reason"
            },
            {
              "transitionId": "MOD-SYS-LISTEN-TR-005",
              "from": "CLOSED",
              "to": "ACTION_TRACKING",
              "operationId": "modern.listening.action.create",
              "guard": "cohort meets anonymity threshold and action owner assigned"
            },
            {
              "transitionId": "MOD-SYS-LISTEN-TR-006",
              "from": "ACTION_TRACKING",
              "to": "COMPLETED",
              "operationId": "modern.listening.action.complete",
              "guard": "completion evidence and non-retaliation review receipt present"
            }
          ]
        }
