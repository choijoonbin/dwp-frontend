        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "originalSource": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "column",
        "sqlType",
        "sourceStatus",
        "inputs",
        "originalSource"
      ]
    },
    "PAYV2.FixtureFacts": {
