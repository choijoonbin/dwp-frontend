        "dutyAllowed": {
          "type": "boolean"
        },
        "fieldPolicyAllowed": {
          "type": "boolean"
        },
        "stepUpVerified": {
          "type": "boolean"
        },
        "authUserVersion": {
          "type": "integer",
          "minimum": 0
