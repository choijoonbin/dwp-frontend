    "PAYV2.ConfigurationResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "schemaVersion": {
          "const": "PAYROLL_CONFIG_GOVERNANCE_V2"
        },
        "artifactKind": {
          "enum": [
            "ENTITY",
            "PAYGROUP",
            "CALENDAR",
            "ROUNDING",
            "ELIGIBILITY",
            "ELEMENT",
            "FORMULA",
            "GL_MAPPING"
          ]
        },
        "scope": {
          "$ref": "#/$defs/PAYV2.ConfigurationScope"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 0
        },
        "ownerRevision": {
          "type": "integer",
          "minimum": 0
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "operatorRegistryVersion": {
          "const": "PAY_RULE_AST_V1"
        },
        "currencyRegistry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeZoneRegistry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvalPolicyId": {
          "type": "string",
          "format": "uuid"
        },
        "retentionPolicyId": {
          "type": "string",
          "format": "uuid"
        },
        "allowedArtifactKinds": {
          "type": "array",
          "items": {
            "enum": [
              "ENTITY",
              "PAYGROUP",
              "CALENDAR",
              "ROUNDING",
              "ELIGIBILITY",
              "ELEMENT",
              "FORMULA",
              "GL_MAPPING"
            ]
          }
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "snapshotId",
        "schemaVersion",
        "artifactKind",
        "scope",
        "policyRevision",
        "ownerRevision",
        "asOf",
        "validFrom",
        "validTo",
        "expiresAt",
        "operatorRegistryVersion",
        "currencyRegistry",
        "timeZoneRegistry",
        "approvalPolicyId",
        "retentionPolicyId",
        "allowedArtifactKinds",
        "payloadDigest"
      ]
    },
    "PAYV2.StatementAuthorityQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statementPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "statementVersion": {
          "type": "integer",
          "minimum": 0
        },
        "statementDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "enum": [
            "READ",
            "DOWNLOAD"
          ]
        },
        "purpose": {
          "enum": [
            "SELF_PAY_READ",
            "SELF_PAY_DOWNLOAD"
          ]
        }
      },
      "required": [
        "statementPublicId",
        "statementVersion",
        "statementDigest",
        "action",
        "purpose"
      ]
    },
    "PAYV2.StatementAuthority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "integer",
          "minimum": 1
        },
        "principalPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "personPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "statementPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "statementVersion": {
          "type": "integer",
          "minimum": 0
        },
        "statementDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "historicalWorkerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "historicalWorkRelationshipPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "historicalLegalEmployerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "enum": [
            "READ",
            "DOWNLOAD"
          ]
        },
        "purpose": {
          "enum": [
            "SELF_PAY_READ",
            "SELF_PAY_DOWNLOAD"
          ]
        },
        "appEntitled": {
          "type": "boolean"
