{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:dwp:pay:base:preparation:v2:author",
  "status": "AUTHOR_SCHEMA_ONLY_NOT_CANONICAL",
  "$defs": {
    "PAYV2.NativeSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "workRelationshipPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "assignmentPublicId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workerPublicId",
        "workRelationshipPublicId",
        "assignmentPublicId"
      ]
    },
    "PAYV2.AuthBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "integer",
          "minimum": 1
        },
        "userId": {
          "type": "integer",
          "minimum": 1
        },
        "principalPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "personPublicId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "identityPlane": {
          "enum": [
            "TENANT",
            "PLATFORM"
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "INVITED",
            "SUSPENDED",
            "INACTIVE"
          ]
        },
        "userRowVersion": {
          "type": "integer",
          "minimum": 0
        },
        "accessRevision": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenantId",
        "userId",
        "principalPublicId",
        "personPublicId",
        "identityPlane",
        "status",
        "userRowVersion",
        "accessRevision",
        "capturedAt",
        "expiresAt"
      ]
    },
    "PAYV2.NativeWorker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicId": {
          "type": "string",
          "format": "uuid"
        },
        "personPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "publicId",
        "personPublicId",
        "version",
        "status"
      ]
    },
    "PAYV2.NativeRelationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicId": {
          "type": "string",
          "format": "uuid"
        },
        "workerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "legalEmployerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "publicId",
        "workerPublicId",
        "legalEmployerPublicId",
        "version",
        "startDate",
        "endDate"
      ]
    },
    "PAYV2.NativeAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicId": {
          "type": "string",
          "format": "uuid"
        },
        "workRelationshipPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "effectiveStartDate": {
          "type": "string",
          "format": "date"
        },
        "effectiveEndDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "workZone": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "publicId",
        "workRelationshipPublicId",
        "version",
        "status",
        "effectiveStartDate",
        "effectiveEndDate",
        "workZone"
      ]
