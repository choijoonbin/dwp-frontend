        "authAccessRevision": {
          "type": "integer",
          "minimum": 0
        },
        "personVersion": {
          "type": "integer",
          "minimum": 0
        },
        "statementOwnerRevision": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenantId",
        "principalPublicId",
        "personPublicId",
        "statementPublicId",
        "statementVersion",
        "statementDigest",
        "historicalWorkerPublicId",
        "historicalWorkRelationshipPublicId",
        "historicalLegalEmployerPublicId",
        "action",
        "purpose",
        "appEntitled",
        "dutyAllowed",
        "fieldPolicyAllowed",
        "stepUpVerified",
        "authUserVersion",
        "authAccessRevision",
        "personVersion",
        "statementOwnerRevision",
        "capturedAt",
        "expiresAt"
      ]
    },
    "PAYV2.Download": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purposeCode": {
          "const": "SELF_PAY_DOWNLOAD"
        },
        "statementAuthority": {
          "$ref": "#/$defs/PAYV2.StatementAuthorityQuery"
        }
      },
      "required": [
        "purposeCode",
        "statementAuthority"
      ]
