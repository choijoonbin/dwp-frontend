        "expectedSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "expectedPolicyRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedPayloadDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifactKind",
        "scope",
        "asOf",
        "validFrom",
        "validTo",
        "expectedSchemaVersion",
        "expectedPolicyRevision",
        "expectedPayloadDigest"
      ]
