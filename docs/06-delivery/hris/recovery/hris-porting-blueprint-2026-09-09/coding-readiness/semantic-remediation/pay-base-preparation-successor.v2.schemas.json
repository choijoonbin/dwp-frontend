    "PAYV2.NativeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": {
          "$ref": "#/$defs/PAYV2.NativeWorker"
        },
        "relationship": {
          "$ref": "#/$defs/PAYV2.NativeRelationship"
        },
        "assignment": {
          "$ref": "#/$defs/PAYV2.NativeAssignment"
        }
      },
      "required": [
        "worker",
        "relationship",
        "assignment"
      ]
    },
    "PAYV2.NativeContextSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "integer",
          "minimum": 1
        },
        "personPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "personVersion": {
          "type": "integer",
          "minimum": 0
        },
        "personState": {
          "enum": [
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PAYV2.NativeContext"
          }
        }
      },
      "required": [
        "tenantId",
        "personPublicId",
        "personVersion",
        "personState",
        "asOf",
        "complete",
        "contexts"
      ]
    },
    "PAYV2.NativeLegalEmployer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "integer",
          "minimum": 1
        },
        "publicId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "lifecycleState": {
          "enum": [
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenantId",
        "publicId",
        "version",
        "lifecycleState",
        "countryCode",
        "capturedAt",
        "expiresAt"
      ]
    },
    "PAYV2.ConfigurationScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legalPayrollEntityId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "payGroupId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "legalPayrollEntityId",
        "payGroupId"
      ]
    },
    "PAYV2.ConfigurationQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactKind": {
          "enum": [
            "ENTITY",
            "PAYGROUP",
            "CALENDAR",
            "ROUNDING",
            "ELIGIBILITY",
            "ELEMENT",
            "FORMULA",
            "GL_MAPPING"
          ]
        },
        "scope": {
          "$ref": "#/$defs/PAYV2.ConfigurationScope"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
