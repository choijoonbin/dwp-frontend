        "workerVersion": {
          "type": "integer",
          "minimum": 0
        },
        "relationshipVersion": {
          "type": "integer",
          "minimum": 0
        },
        "assignmentVersion": {
          "type": "integer",
          "minimum": 0
        },
        "legalEmployerPublicId": {
          "type": "string",
          "format": "uuid"
        },
        "legalEmployerVersion": {
          "type": "integer",
          "minimum": 0
