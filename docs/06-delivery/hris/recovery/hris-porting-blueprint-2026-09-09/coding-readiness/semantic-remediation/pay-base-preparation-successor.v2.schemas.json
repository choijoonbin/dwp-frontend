      "required": [
        "personPublicId",
        "selector",
        "personVersion",
        "workerVersion",
        "relationshipVersion",
        "assignmentVersion",
        "legalEmployerPublicId",
        "legalEmployerVersion",
        "asOf",
        "inclusiveFrom",
        "inclusiveTo",
        "ownerZone"
      ]
    },
    "PAYV2.PhysicalSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "sqlType": {
          "type": "string",
          "minLength": 1
        },
        "sourceStatus": {
          "enum": [
            "DIRECT_PLANNED",
            "OPEN_BUSINESS_TRANSFORM",
            "OPEN_HISTORICAL_SOURCE",
            "OPEN_PHASE_BINDING"
