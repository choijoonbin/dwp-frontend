          "type": "string",
          "format": "date-time"
        },
        "inclusiveFrom": {
          "type": "string",
          "format": "date"
        },
        "inclusiveTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerZone": {
          "type": "string",
          "minLength": 1
        }
