    "WorkforceHomeQuery": {"type":"object","additionalProperties":false,"properties":{"asOf":{"$ref":"#/$defs/Instant"},"widgetKeys":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,39}$"},"minItems":1,"maxItems":30,"uniqueItems":true}},"required":["asOf","widgetKeys"]},
