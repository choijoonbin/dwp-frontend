    "CommandHeaders": {"type":"object","additionalProperties":false,"properties":{"Authorization":{"type":"string","pattern":"^Bearer .+$"},"Idempotency-Key":{"type":"string","minLength":16,"maxLength":128},"If-Match":{"type":"string","pattern":"^(W/)?\"[A-Za-z0-9._:-]+\"$"},"X-Correlation-ID":{"$ref":"#/$defs/Uuid"},"X-Purpose-Code":{"type":"string","minLength":3,"maxLength":64}},"required":["Authorization","Idempotency-Key","If-Match","X-Correlation-ID"]},
