    "Receipt": {"type":"object","additionalProperties":false,"properties":{"receiptId":{"$ref":"#/$defs/Uuid"},"commandType":{"type":"string","minLength":1},"status":{"type":"string","enum":["RECEIVED","VALIDATING","RUNNING","SUCCEEDED","REJECTED","FAILED_RETRYABLE","DEAD","CANCELLED"]},"requestHash":{"$ref":"#/$defs/Digest"},"correlationId":{"$ref":"#/$defs/Uuid"},"receivedAt":{"$ref":"#/$defs/Instant"},"originatingAction":{"type":"string","minLength":1,"maxLength":160},"subjectPrincipalPublicId":{"$ref":"#/$defs/Uuid"},"populationScopeDigest":{"$ref":"#/$defs/Digest"},"fieldPolicyRevision":{"type":"integer","minimum":1},"purposeCode":{"type":"string","minLength":3,"maxLength":80},"authorizationRevision":{"type":"integer","minimum":1},"links":{"type":"object","additionalProperties":false,"properties":{"self":{"type":"string","format":"uri-reference"},"result":{"type":"string","format":"uri-reference"},"target":{"type":"string","format":"uri-reference"}},"required":["self"]}},"required":["receiptId","commandType","status","requestHash","correlationId","receivedAt","originatingAction","subjectPrincipalPublicId","populationScopeDigest","fieldPolicyRevision","purposeCode","authorizationRevision","links"]},
    "EmptyCommand": {"type":"object","additionalProperties":false,"properties":{},"required":[]},
