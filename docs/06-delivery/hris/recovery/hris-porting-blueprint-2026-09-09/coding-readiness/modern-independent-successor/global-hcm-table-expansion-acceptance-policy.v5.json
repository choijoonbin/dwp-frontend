    "addedRows": [
      {"tableId":"ppl_rec_offer_decisions","ownerSession":"HRIS-HRM","producers":["modern.recruiting.offer.respond"],"requirementIds":["P0-REC-001","P1-DECISION-003"],"readConsumers":["modern.recruiting.candidate.query","modern.recruiting.candidates.query"],"nonReplaceability":"Offer acceptance or rejection actor mode, subject, delegation/source receipt and reason are immutable decision facts; mutating ppl_rec_offers status cannot preserve decision history."},
