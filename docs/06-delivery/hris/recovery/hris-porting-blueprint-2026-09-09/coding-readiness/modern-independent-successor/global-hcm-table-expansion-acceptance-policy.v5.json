      {"tableId":"ppl_bnf_enrollment_eligibility_receipts","ownerSession":"HRIS-HRM","producers":["modern.benefits.enrollment.submit"],"requirementIds":["P0-BNF-001"],"readConsumers":["modern.benefits.enrollment.query","modern.benefits.enrollments.query"],"nonReplaceability":"Eligibility policy/snapshot/decision proof must remain immutable and auditable independently of a mutable enrollment status."},
      {"tableId":"ppl_bnf_dependent_elections","ownerSession":"HRIS-HRM","producers":["modern.benefits.enrollment.submit"],"requirementIds":["P0-BNF-001"],"readConsumers":["modern.benefits.enrollment.query","modern.benefits.enrollments.query"],"nonReplaceability":"A bounded ordered set of tokenized dependent relationship elections requires per-row uniqueness, option/version linkage and field-policy-safe query lineage; a digest cannot reproduce it."},
