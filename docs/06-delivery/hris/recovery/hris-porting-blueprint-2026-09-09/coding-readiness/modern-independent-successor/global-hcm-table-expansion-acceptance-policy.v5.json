      {"tableId":"ppl_cwk_access_receipts","ownerSession":"HRIS-HRM","producers":["internal.contingent.access-grant-result.consume","internal.contingent.access-revoke-result.consume"],"requirementIds":["P0-CWK-001"],"readConsumers":["modern.contingent.engagement.query","modern.contingent.engagements.query"],"nonReplaceability":"Signed access grant/revoke outcomes are immutable owner receipts on a separate access lifecycle; engagement state cannot serve as their proof."},
      {"tableId":"ppl_cwk_engagement_versions","ownerSession":"HRIS-HRM","producers":["internal.contingent.access-expiry.initiate","internal.contingent.access-grant-result.consume","internal.contingent.access-revoke-result.consume","modern.contingent.engagement.activate","modern.contingent.engagement.create","modern.contingent.engagement.offboard","modern.contingent.engagement.reject","modern.contingent.engagement.revise","modern.contingent.engagement.submit","modern.contingent.sponsor.reassign"],"requirementIds":["P0-CWK-001","P1-EFFECTIVE-004"],"readConsumers":["modern.contingent.engagement.query","modern.contingent.engagements.query"],"nonReplaceability":"A stable engagement identity cannot also be overwritten to represent correction and future supersession; dual append-only root and effective-segment predecessor chains preserve classification/access intent and reason without prior-row mutation. Base segments define derived next-boundaries, while corrections intentionally reuse the same segment and effective_from."},
      {"tableId":"prf_lrn_offering_versions","ownerSession":"HRIS-PER","producers":["modern.learning.offering.create","modern.learning.offering.publish","modern.learning.offering.retire","modern.learning.offering.revise"],"requirementIds":["P0-LRN-001","P1-EFFECTIVE-004"],"readConsumers":["modern.learning.offering.query","modern.learning.catalog.query"],"nonReplaceability":"Executable content, delivery/session, capacity, eligibility and skill-map revisions must be addressable as-of without rewriting the offering root."},
      {"tableId":"prf_lrn_capacity_ledger","ownerSession":"HRIS-PER","producers":["modern.learning.assignment.cancel","modern.learning.assignment.create","modern.learning.self.enroll"],"requirementIds":["P0-LRN-001"],"readConsumers":["modern.learning.assignment.query","modern.learning.assignments.query"],"nonReplaceability":"Atomic reserve, release and waitlist ordering are ledger facts needed for concurrency-safe capacity replay and cannot be reduced to an offering counter."},
      {"tableId":"prf_mkt_opportunity_versions","ownerSession":"HRIS-PER","producers":["modern.opportunity.cancel","modern.opportunity.close","modern.opportunity.create","modern.opportunity.publish","modern.opportunity.revise"],"requirementIds":["P0-MKT-001"],"readConsumers":["modern.opportunity.query","modern.opportunity.catalog.query","modern.opportunity.application.query","modern.opportunity.applications.query"],"nonReplaceability":"Criteria, capacity and skill requirements must be pinned to the opportunity revision seen by applicants and explanations; mutable root columns cannot preserve that historical input."},
      {"tableId":"prf_suc_plan_versions","ownerSession":"HRIS-PER","producers":["modern.succession.nomination.add","modern.succession.nomination.withdraw","modern.succession.plan.approve","modern.succession.plan.create","modern.succession.plan.publish","modern.succession.plan.reject","modern.succession.plan.retire","modern.succession.plan.revise","modern.succession.plan.submit","modern.succession.readiness.record"],"requirementIds":["P0-SUC-001","P1-EFFECTIVE-004"],"readConsumers":["modern.succession.plan.query","modern.succession.plans.query"],"nonReplaceability":"Stable succession-plan identity must be separated from restricted audience, key-position, content and effective-time revisions; a publication receipt cannot reproduce historical plan content or authorization policy."},
      {"tableId":"prf_cmp_proposal_versions","ownerSession":"HRIS-PER","producers":["modern.compplan.proposal.upsert"],"requirementIds":["P0-CMP-001"],"readConsumers":["modern.compplan.proposal.query","modern.compplan.proposals.query"],"nonReplaceability":"Every compensation amount/component/reason/effective-date CAS revision must remain frozen for approval and snapshot derivation rather than being overwritten in the proposal root."},
      {"tableId":"prf_cmp_plan_proposal_refs","ownerSession":"HRIS-PER","producers":["modern.compplan.plan.approve"],"requirementIds":["P0-CMP-001"],"readConsumers":["modern.compplan.cycle.query","modern.compplan.cycles.query","modern.compplan.proposal.query","modern.compplan.proposals.query"],"nonReplaceability":"Plan approval freezes an exact ordered proposal-ID/version set; a plan digest cannot prove membership or support server-derived approved snapshot lines."},
      {"tableId":"tme_wfm_approval_receipts","ownerSession":"HRIS-TIM","producers":["internal.wfm.approval-result.consume"],"requirementIds":["P0-WFM-001"],"readConsumers":["modern.wfm.candidate.query","modern.wfm.candidates.query"],"nonReplaceability":"Approval outcome, decision receipt and candidate version are immutable facts separate from candidate status and are required for publish admission and historical refetch."},
      {"tableId":"sys_hris_ai_assistance_reviews","ownerSession":"HRIS-SYS","producers":["modern.ai.assist.review","modern.ai.assist.revoke"],"requirementIds":["P0-AI-001"],"readConsumers":["modern.ai.assistance.query","modern.ai.assistances.query"],"nonReplaceability":"Human actor, assistance/subject identity, confirm-or-reject decision, reason and decision/delegation receipt have a distinct audience and retention lifecycle from model-output provenance and must remain immutable."}
