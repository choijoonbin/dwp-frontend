      { "id": "PAY004-AC-04", "result": "PASS_ADMITTED_REUSE_ONLY", "evidence": "PAY-003 signed-pack state and action ownership remain unchanged; only immutable pack facts are bound." },
      { "id": "PAY004-AC-05", "result": "PASS_ADMITTED_REUSE_ONLY", "evidence": "V50 calculation and PayrollCalculated.v1 remain unchanged with no retirement calculation command or event." },
      { "id": "PAY004-AC-06", "result": "PASS_ADMITTED", "evidence": "Closed append-only state machine, terminal immutability, maker-checker separation and linked correction are enforced." },
      { "id": "PAY004-AC-07", "result": "PASS_ADMITTED", "evidence": "Payroll V55 creates exactly five leased tables and no receipt, outbox, audit, seed or backfill." },
      { "id": "PAY004-AC-08", "result": "PASS_ADMITTED", "evidence": "All five tables have tenant-first identity, PUBLIC revocation, least privilege, FORCE RLS and mutation rejection." },
