      { "id": "PAY004-AC-12", "result": "PASS_ADMITTED_UNMOUNTED_COMPONENT", "evidence": "Seven UI states, accessibility, responsive widths, zoom, themes, reduced motion and default-OFF zero-call behavior are covered." }
