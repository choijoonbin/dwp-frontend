  "findings": [
    {
      "id": "PAY003-REVIEW-P1-01",
      "title": "V53 actor cross-wire",
      "status": "CLOSED",
      "change": "All three deferred closure branches require activation.activated_by_subject_public_id = receipt.subject_principal_public_id.",
      "proof": "activationReceiptActorCrossWireIsRejectedAtCommit inserts a coherent pack/revision/correlation/event closure with different activation and receipt subjects; PostgreSQL rejects commit and leaves no activation, receipt or outbox effects."
    },
    {
      "id": "PAY003-REVIEW-P1-02",
      "title": "PostgreSQL SoD evidence gap",
      "status": "CLOSED",
      "change": "Added an actual PostgreSQL insert using the same installer and statutory approver; no production constraint was weakened.",
      "proof": "identicalInstallerAndStatutoryApproverIsRejectedByPostgres observes pay_country_pack_snapshot_sod rejection and zero persisted snapshot rows."
    },
    {
      "id": "PAY003-REVIEW-P1-03",
      "title": "Frontend exact query validation drift",
      "status": "CLOSED",
      "change": "Metadata keys/versions and policy keys now use the owner's leading-alphanumeric token grammar. Both amount filters reject minimum > maximum using exact signed scaled BigInt comparison at six decimal places.",
      "proof": "The one existing query-validator named case rejects leading punctuation, reversed positive/negative ranges and ranges above JavaScript's safe integer boundary; valid signed six-decimal input remains accepted."
    },
    {
      "id": "PAY003-REVIEW-P1-04",
      "title": "Closed Problem catch-all status",
      "status": "CLOSED",
      "change": "Unexpected exceptions map to HTTP 503 RESULT_UNKNOWN.",
      "proof": "unexpectedFailureUsesClosed503ProblemAndKeepsCorrelation checks exact closed response fields, retryable=true, private/no-store cache policy and unchanged correlation."
    }
  ],
