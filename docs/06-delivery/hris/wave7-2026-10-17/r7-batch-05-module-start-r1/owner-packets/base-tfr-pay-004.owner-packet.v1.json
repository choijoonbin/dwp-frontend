  "acceptanceCriteria": [
    {
      "id": "PAY004-AC-01",
      "criterion": "IAQ-049 implements exactly the accepted GET browser and owner paths, RETIREMENT variant, four filters, eight sorts, itemPublicId default sort, limit 1 through 100, canonical route and COMPLETE, EMPTY, PARTIAL and UNAVAILABLE cardinality rules."
    },
    {
      "id": "PAY004-AC-02",
      "criterion": "IAQ-049 enforces all seven PEP layers, trusted-tenant and authorized-population scope, VIEW, MASK and OMIT before serialization, exact field-decision counts, scope and authorization revision-bound opaque cursors and problem correlation."
    },
    {
      "id": "PAY004-AC-03",
      "criterion": "Every IAQ-049 item has one retirement-case itemPublicId and availableActions is empty; runId or packId is never inferred from any item, field, deep link, filter, result, title, policy value, mask or browser state, and IAQ access never confers PEP action authority."
    },
    {
      "id": "PAY004-AC-04",
      "criterion": "PEP-PAY-028 and PAY-003 signed-pack state are reused unchanged with expected-version CAS, HIGH step-up, official references, effective date, golden-pack digest, same-scope statutory approval and exactly PACK_INSTALLER_NE_STATUTORY_APPROVER; no duplicate action, receipt, migration or completion credit exists."
    },
    {
      "id": "PAY004-AC-05",
      "criterion": "PEP-PAY-012, PEP-PAY-014, the V50 generic engine and PayrollCalculated.v1 are reused unchanged; PAY-004 creates no retirement-specific calculation endpoint or event, does not change the five-field event payload and never derives a retirement result from generic deduction lines or control totals."
    },
    {
      "id": "PAY004-AC-06",
      "criterion": "The RetirementYearEndCase states, terminal states and transitions are exact, every transition is append-only, terminal evidence is immutable, correction links a new revision, and no uncontracted public case command, action, receipt or event is introduced."
    },
    {
      "id": "PAY004-AC-07",
      "criterion": "Payroll V55 creates exactly the five sealed retirement case tables, reuses V50 pay_outbox_events and V54 sys_audit_outbox, preserves V1 through V54 byte-for-byte and adds no generic receipt, audit or outbox duplicate, seed or backfill."
    },
    {
      "id": "PAY004-AC-08",
      "criterion": "Every V55 table has tenant-first composite identity and intra-Payroll foreign keys, UUID public IDs, PUBLIC revocation, least-privilege non-BYPASSRLS grants, ENABLE plus FORCE RLS using trusted dwp.payroll_tenant_id and immutable UPDATE and DELETE guards."
    },
    {
      "id": "PAY004-AC-09",
      "criterion": "Case, basis, evidence, result and correction facts are immutable monotonic revisions; each result references the exact V50 (tenant, run, attempt, worker-result) identity and proves the same case worker. ACTIVE cases bind the exact V53 pack snapshot and ACTIVE activation revision effective at calculation time; NOT_REQUIRED cases have null pack references and bind an explicit non-pack Payroll foundation or policy public ID, revision and digest. Mutable latest, cross-tenant, cross-worker, cross-scope, stale or missing references fail closed."
    },
    {
      "id": "PAY004-AC-10",
      "criterion": "Retirement results use PostedMoney NUMERIC(19,4), one explicit currency and declared application rounding, canonical decimal and digest rules, prohibit floating point, database rounding and cross-currency arithmetic, and contain no hardcoded law, rate, report, provider or tenant-specific content."
    },
    {
      "id": "PAY004-AC-11",
      "criterion": "Existing owner idempotency, expected-version, original-receipt replay, different-digest 409, minimized audit, maker-checker and atomic outbox guarantees remain exact; PAY-004 adds no parallel command receipt store and pack-required cases fail closed without silent fallback."
    },
    {
      "id": "PAY004-AC-12",
      "criterion": "The future frontend proves loading, empty, partial, unavailable, denied, stale and complete list-detail states, keyboard and screen-reader operation, responsive 1440, 1280, 390 and 320 widths, 200 percent zoom, light, dark, high contrast and reduced motion, plus default-OFF zero network calls; route mount, menu exposure, feature enablement, tenant enrollment and production provider binding remain non-claims."
    }
  ],
