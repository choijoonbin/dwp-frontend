  "findings": [
    {
      "id": "HRM005-BLOCKER-001",
      "severity": "P0",
      "result": "PROVEN",
      "evidence": [
        "dwp-people-server/src/main/java/com/dwp/services/people/security/HcmScopeSelectionValidator.java requires field group ORGANIZATION for the two organization graph routes.",
        "dwp-people-server/src/main/java/com/dwp/services/people/workforce/WorkforceAccessPolicyService.java accepts only DIRECTORY, WORKER_IDENTIFIERS, EMPLOYMENT and JOB_GRADE.",
        "dwp-people-server/src/main/resources/db/migration/V34__add_workforce_access_boundaries.sql rejects ORGANIZATION in ck_workforce_access_policy_fields."
      ],
      "impact": "No persisted production policy can satisfy the sealed v49 organization viewer decision, so an enabled request fails before the HRM-005 controller.",
      "decision": "Preserve ORGANIZATION semantics and add it append-only in People V57; do not weaken the contract to DIRECTORY and do not mutate V34."
    },
    {
      "id": "HRM005-BLOCKER-002",
      "severity": "P0",
      "result": "PROVEN",
      "evidence": [
        "HcmScopeSelectionValidator accepts ORGANIZATION_TARGET_POPULATION for the exact graph routes.",
        "OrganizationChartService.chartDecision revalidates operations traffic with WORKFORCE_TARGET_POPULATION or ORG_UNIT/LEGAL_ENTITY.",
        "The resolver source is an input to the owner-derived scope digest."
      ],
      "impact": "The same request cannot pass both owner checks even when its tenant, population and policy are current.",
      "decision": "Add a route-key-exact graph branch in OrganizationChartService that requires ORGANIZATION and revalidates only ORGANIZATION_TARGET_POPULATION; retain every management and legacy workforce chart branch unchanged."
    }
  ],
  "successorAuthority": {
    "migrationLeaseRequired": true,
    "migration": {
      "stream": "PEOPLE_MAIN",
      "version": "V57",
      "path": "dwp-people-server/src/main/resources/db/migration/V57__allow_organization_workforce_field_group.sql",
      "semantics": [
        "Drop and recreate only ck_workforce_access_policy_fields.",
        "Preserve the existing four field groups and add ORGANIZATION.",
        "Require nonempty field_groups exactly as V34 does."
      ],
      "forbidden": [
        "V34 mutation",
        "data backfill",
        "automatic role or policy elevation",
        "tenant enrollment",
        "a second People migration"
      ]
    },
