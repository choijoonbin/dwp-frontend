{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/hris/g7/closure-receipt.schema.v3.json",
  "title": "G7 SYS/HRM integrated closure receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "runId", "status", "issuedAt", "issuedBy", "authorization", "centralIntegration", "sharedControlVerification", "tokenClosures", "modPerCompplanReadiness", "authority", "sealedPayloadSha256"],
  "properties": {
    "schema": {"const": "dwp.hris.g7-sys-hrm-integrated-closure-receipt.v3"},
    "receiptId": {"type": "string", "pattern": "^HRIS-G7-SYS-HRM-INTEGRATED-CLOSURE-[A-Z0-9-]+$"},
    "runId": {"$ref": "#/$defs/runId"},
    "status": {"const": "PASS_INTEGRATED_CLOSURE_PENDING_CARRIER"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "issuedBy": {"const": "SYS_COMMON_INTEGRATION_CONTROL"},
    "authorization": {"$ref": "#/$defs/receiptRef"},
    "centralIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedUnionSha256", "onlyExpectedUnionChanges", "repositories"],
      "properties": {
        "expectedUnionSha256": {"$ref": "#/$defs/sha256"},
        "onlyExpectedUnionChanges": {"const": true},
        "repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frontend", "backend"],
          "properties": {
            "frontend": {"$ref": "#/$defs/integrationResult"},
            "backend": {"$ref": "#/$defs/integrationResult"}
          }
        }
      }
    },
    "sharedControlVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitBlobSha1", "sha256", "bytes", "carrierCommit", "carrierTree", "evidenceId", "singleBatch", "planAuthorityStatus"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "gitBlobSha1": {"$ref": "#/$defs/sha1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "carrierCommit": {"$ref": "#/$defs/sha1"},
        "carrierTree": {"$ref": "#/$defs/sha1"},
        "evidenceId": {"type": "string", "minLength": 1},
        "singleBatch": {"const": true},
        "planAuthorityStatus": {"const": "CONTROL_PROPOSAL_NOT_PREDECESSOR_AUTHORITY"}
      }
    },
    "tokenClosures": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/tokenClosure"}},
    "modPerCompplanReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceId", "status", "authorityStatus", "implementationTokenIssued", "sourceChangeAuthorized", "payConsumerReady", "nextRequiredActions"],
      "properties": {
        "sliceId": {"const": "MOD-PER-COMPPLAN"},
        "status": {"const": "CONTROL_PROPOSAL_READY_FOR_PACKET_PREPARATION"},
        "authorityStatus": {"const": "CONTROL_PROPOSAL_NOT_CANONICAL_START_AUTHORITY"},
        "implementationTokenIssued": {"const": false},
        "sourceChangeAuthorized": {"const": false},
        "payConsumerReady": {"const": false},
        "nextRequiredActions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveAfterCarrier", "integrationMergeAuthorized", "customerDataAuthorized", "customerActivationAuthorized", "productionReleaseAuthorized"],
      "properties": {
        "effectiveAfterCarrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sysHrmTokensClosed", "modPerCompplanPacketPreparationMayBegin"],
          "properties": {
            "sysHrmTokensClosed": {"const": true},
            "modPerCompplanPacketPreparationMayBegin": {"const": true}
          }
        },
        "integrationMergeAuthorized": {"const": false},
        "customerDataAuthorized": {"const": false},
        "customerActivationAuthorized": {"const": false},
        "productionReleaseAuthorized": {"const": false}
      }
    },
    "sealedPayloadSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "path": {"type": "string", "minLength": 1},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "gitBlobSha1", "sha256", "bytes", "carrierCommit", "carrierTree", "receiptId"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "gitBlobSha1": {"$ref": "#/$defs/sha1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "carrierCommit": {"$ref": "#/$defs/sha1"},
        "carrierTree": {"$ref": "#/$defs/sha1"},
        "receiptId": {"type": "string", "minLength": 1}
      }
    },
    "commitTreePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {"commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"}}
    },
    "integratedPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "upstream", "upstreamContainsCommit"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "branch": {"type": "string", "minLength": 1},
        "upstream": {"type": "string", "minLength": 1},
        "upstreamContainsCommit": {"const": true}
      }
    },
    "blobPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "gitBlobSha1", "bytes", "sha256"],
      "properties": {
        "mode": {"type": "string", "pattern": "^[0-9]{6}$"},
        "gitBlobSha1": {"$ref": "#/$defs/sha1"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableBlobPin": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobPin"}]},
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change", "before", "after"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "change": {"enum": ["ADD", "MODIFY", "DELETE"]},
        "before": {"$ref": "#/$defs/nullableBlobPin"},
        "after": {"$ref": "#/$defs/nullableBlobPin"}
      }
    },
    "integrationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "preIntegration", "integrated", "changedFiles", "changedFilesSha256"],
      "properties": {
        "repo": {"enum": ["frontend", "backend"]},
        "preIntegration": {"$ref": "#/$defs/commitTreePin"},
        "integrated": {"$ref": "#/$defs/integratedPin"},
        "changedFiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/manifestItem"}},
        "changedFilesSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tokenClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "sliceId", "tokenId", "stateAfterCarrier"],
      "properties": {
        "module": {"enum": ["SYS", "HRM"]},
        "sliceId": {"enum": ["BASE-TFR-SYS-007", "BASE-TFR-HRM-010"]},
        "tokenId": {"enum": ["G7-START-SYS-BASE-TFR-SYS-007-R2", "G7-START-HRM-BASE-TFR-HRM-010-R2"]},
        "stateAfterCarrier": {"const": "RESULT_INTEGRATED_CLOSED"}
      }
    }
  }
}
