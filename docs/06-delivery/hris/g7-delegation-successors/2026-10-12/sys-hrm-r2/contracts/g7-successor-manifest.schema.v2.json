{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dwp.hris.g7-successor-manifest.schema.v2",
  "type": "object",
  "required": [
    "schema",
    "manifestId",
    "issuedAt",
    "predecessorPins",
    "controlBootstrapReceipt",
    "executionBasePins",
    "activeTokenClosedSetAfterPromotion",
    "artifacts",
    "toolPins",
    "artifactCount",
    "sealedPayloadSha256"
  ],
  "properties": {
    "schema": {
      "const": "dwp.hris.g7-sys-hrm-successor-manifest.v2"
    },
    "activeTokenClosedSetAfterPromotion": {
      "const": [
        "G7-START-SYS-BASE-TFR-SYS-007-R2",
        "G7-START-HRM-BASE-TFR-HRM-010-R2"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/filePin"
      }
    },
    "toolPins": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/filePin"
      }
    },
    "artifactCount": {
      "const": 5
    },
    "sealedPayloadSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "filePin": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
