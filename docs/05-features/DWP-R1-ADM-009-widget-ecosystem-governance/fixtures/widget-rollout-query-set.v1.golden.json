{
  "fixtureVersion": 1,
  "expectedQuerySetRevision": "dbea80caee9b8da19e53fa0101c8bd7e9728fb62c207e809f15c76cbdd451480",
  "querySet": {
    "schemaVersion": 1,
    "sourceProvider": "PROMETHEUS",
    "evidenceWindowSeconds": 86400,
    "evaluationCadenceSeconds": 60,
    "templateVariables": {
      "ring": ["staging-bootstrap", "staging-shadow"]
    },
    "queries": [
      {
        "queryId": "diff-counts",
        "outputField": "diffCounts",
        "unit": "count",
        "resultRounding": "CEIL",
        "seriesLabel": "diff_bucket",
        "seriesToFields": {
          "STATIC_ONLY": "diffCounts.STATIC_ONLY",
          "SHADOW_ONLY": "diffCounts.SHADOW_ONLY",
          "STATE_MISMATCH": "diffCounts.STATE_MISMATCH",
          "ADDABILITY_MISMATCH": "diffCounts.ADDABILITY_MISMATCH",
          "VERSION_UNRESOLVED": "diffCounts.VERSION_UNRESOLVED",
          "BINDING_MISMATCH": "diffCounts.BINDING_MISMATCH",
          "SAFETY_MISMATCH": "diffCounts.SAFETY_MISMATCH"
        },
        "promql": "sum by (diff_bucket) (increase(dwp_widget_shadow_diff_total{ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "drill-decision-p99",
        "outputField": "drill.decisionP99",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "seriesLabel": "scenario",
        "seriesToFields": {
          "KILL_DECISION": "drill.killDecisionP99Milliseconds",
          "QUARANTINE_DECISION": "drill.quarantineDecisionP99Milliseconds"
        },
        "promql": "1000 * histogram_quantile(0.99, sum by (scenario, le) (rate(dwp_widget_shadow_drill_delay_seconds_bucket{ring=\"$ring\",scenario=~\"KILL_DECISION|QUARANTINE_DECISION\"}[24h])))"
      },
      {
        "queryId": "drill-would-delay-max",
        "outputField": "drill.wouldDelayMaximum",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "seriesLabel": "scenario",
        "seriesToFields": {
          "WOULD_DENY": "drill.wouldDenyMaximumMilliseconds",
          "WOULD_STOP_DATA": "drill.wouldStopDataMaximumMilliseconds"
        },
        "promql": "1000 * max by (scenario) (max_over_time(dwp_widget_shadow_drill_max_delay_seconds{ring=\"$ring\",scenario=~\"WOULD_DENY|WOULD_STOP_DATA\"}[24h]))"
      },
      {
        "queryId": "evaluation-error-rate-15m-max",
        "outputField": "queue.maxRolling15MinuteEvaluationErrorRateBps",
        "unit": "basis-points",
        "resultRounding": "CEIL",
        "promql": "max_over_time((10000 * sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\",outcome=~\"ERROR|TIMEOUT\"}[15m])) / clamp_min(sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[15m])), 0.000000001))[24h:1m])"
      },
      {
        "queryId": "evaluation-error-rate-1m-max",
        "outputField": "queue.maxOneMinuteEvaluationErrorRateBps",
        "unit": "basis-points",
        "resultRounding": "CEIL",
        "promql": "max_over_time((10000 * sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\",outcome=~\"ERROR|TIMEOUT\"}[1m])) / clamp_min(sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[1m])), 0.000000001))[24h:1m])"
      },
      {
        "queryId": "evaluation-totals",
        "outputField": "samples",
        "unit": "count",
        "resultRounding": "FLOOR",
        "seriesLabel": "placement_context",
        "seriesToFields": {
          "CLASSIC_PERSONAL": "samples.placementContexts.CLASSIC_PERSONAL",
          "FLOW_PERSONAL": "samples.placementContexts.FLOW_PERSONAL",
          "FLOW_GOVERNED": "samples.placementContexts.FLOW_GOVERNED"
        },
        "promql": "sum by (placement_context) (increase(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "evaluation-duration-24h-p99",
        "outputField": "queue.durationP99Milliseconds",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "promql": "1000 * histogram_quantile(0.99, sum by (le) (rate(dwp_widget_shadow_evaluation_duration_seconds_bucket{ring=\"$ring\"}[24h])))"
      },
      {
        "queryId": "evaluation-duration-15m-p99-max",
        "outputField": "queue.maxRolling15MinuteDurationP99Milliseconds",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "promql": "1000 * max_over_time((histogram_quantile(0.99, sum by (le) (rate(dwp_widget_shadow_evaluation_duration_seconds_bucket{ring=\"$ring\"}[15m]))))[24h:1m])"
      },
      {
        "queryId": "evaluation-duration-1m-p99-max",
        "outputField": "queue.maxOneMinuteDurationP99Milliseconds",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "promql": "1000 * max_over_time((histogram_quantile(0.99, sum by (le) (rate(dwp_widget_shadow_evaluation_duration_seconds_bucket{ring=\"$ring\"}[1m]))))[24h:1m])"
      },
      {
        "queryId": "legacy-mismatch-counts",
        "outputField": "drill.legacyMismatchCounts",
        "unit": "count",
        "resultRounding": "CEIL",
        "seriesLabel": "kind",
        "seriesToFields": {
          "PAYLOAD": "drill.legacyPayloadMismatchCount",
          "DATA": "drill.legacyDataMismatchCount"
        },
        "promql": "sum by (kind) (increase(dwp_widget_shadow_legacy_mismatch_total{ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "outbox-dead-letter-increase",
        "outputField": "outbox.deadLetterIncrease",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "sum(increase(dwp_widget_outbox_dead_letter_total{service=\"platform\"}[24h]))"
      },
      {
        "queryId": "outbox-delivery-error-rate-5m-max",
        "outputField": "outbox.maxFiveMinuteDeliveryErrorRateBps",
        "unit": "basis-points",
        "resultRounding": "CEIL",
        "promql": "max_over_time((10000 * sum(rate(dwp_widget_outbox_delivery_total{service=\"platform\",outcome=~\"ERROR|DEAD_LETTER\"}[5m])) / clamp_min(sum(rate(dwp_widget_outbox_delivery_total{service=\"platform\"}[5m])), 0.000000001))[24h:1m])"
      },
      {
        "queryId": "outbox-oldest-age-max",
        "outputField": "outbox.oldestUnpublishedAgeMillisecondsMax",
        "unit": "milliseconds",
        "resultRounding": "CEIL",
        "promql": "1000 * max_over_time(dwp_widget_outbox_oldest_unpublished_age_seconds{service=\"platform\"}[24h])"
      },
      {
        "queryId": "queue-depth-consecutive-max",
        "outputField": "queue.maximumConsecutiveSecondsAboveDepth230",
        "unit": "seconds",
        "resultRounding": "CEIL",
        "promql": "max_over_time(dwp_widget_shadow_queue_depth_above_230_consecutive_seconds{service=\"platform\",ring=\"$ring\"}[24h])"
      },
      {
        "queryId": "queue-depth-max",
        "outputField": "queue.maxDepth",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "max_over_time(dwp_widget_shadow_queue_depth{service=\"platform\"}[24h])"
      },
      {
        "queryId": "queue-rejection-rate-15m-max",
        "outputField": "queue.maxRolling15MinuteRejectionRateBps",
        "unit": "basis-points",
        "resultRounding": "CEIL",
        "promql": "max_over_time((10000 * sum(rate(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[15m])) / clamp_min(sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[15m])) + sum(rate(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[15m])), 0.000000001))[24h:1m])"
      },
      {
        "queryId": "queue-rejection-rate-1m-max",
        "outputField": "queue.maxOneMinuteRejectionRateBps",
        "unit": "basis-points",
        "resultRounding": "CEIL",
        "promql": "max_over_time((10000 * sum(rate(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[1m])) / clamp_min(sum(rate(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[1m])) + sum(rate(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[1m])), 0.000000001))[24h:1m])"
      },
      {
        "queryId": "evaluation-error-count",
        "outputField": "queue.evaluationErrorCount",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "sum(increase(dwp_widget_shadow_evaluations_total{ring=\"$ring\",outcome=~\"ERROR|TIMEOUT\"}[24h]))"
      },
      {
        "queryId": "evaluation-count",
        "outputField": "queue.evaluationCount",
        "unit": "count",
        "resultRounding": "FLOOR",
        "promql": "sum(increase(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "outbox-delivery-error-count",
        "outputField": "outbox.deliveryErrorCount",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "sum(increase(dwp_widget_outbox_delivery_total{service=\"platform\",outcome=~\"ERROR|DEAD_LETTER\"}[24h]))"
      },
      {
        "queryId": "outbox-delivery-attempt-count",
        "outputField": "outbox.deliveryAttemptCount",
        "unit": "count",
        "resultRounding": "FLOOR",
        "promql": "sum(increase(dwp_widget_outbox_delivery_total{service=\"platform\"}[24h]))"
      },
      {
        "queryId": "queue-rejection-count",
        "outputField": "queue.rejectionCount",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "sum(increase(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "queue-enqueue-attempt-count",
        "outputField": "queue.enqueueAttemptCount",
        "unit": "count",
        "resultRounding": "FLOOR",
        "promql": "sum(increase(dwp_widget_shadow_evaluations_total{ring=\"$ring\"}[24h])) + sum(increase(dwp_widget_shadow_queue_rejections_total{service=\"platform\",ring=\"$ring\"}[24h]))"
      },
      {
        "queryId": "unsafe-allow-count",
        "outputField": "unsafeAllowCount",
        "unit": "count",
        "resultRounding": "CEIL",
        "promql": "sum(increase(dwp_widget_shadow_unsafe_allow_total{ring=\"$ring\"}[24h]))"
      }
    ],
    "integerFormulas": [
      {
        "formulaId": "evaluation-error-rate-24h",
        "outputField": "queue.evaluationErrorRateBps",
        "expression": "require(evaluationCount>0&&evaluationErrorCount<=evaluationCount);ceilBigInt(10000*evaluationErrorCount/evaluationCount)"
      },
      {
        "formulaId": "queue-rejection-rate-24h",
        "outputField": "queue.rejectionRateBps",
        "expression": "require(enqueueAttemptCount>0&&rejectionCount<=enqueueAttemptCount);ceilBigInt(10000*rejectionCount/enqueueAttemptCount)"
      },
      {
        "formulaId": "sample-total",
        "outputField": "samples.total",
        "expression": "CLASSIC_PERSONAL+FLOW_PERSONAL+FLOW_GOVERNED"
      }
    ]
  }
}
