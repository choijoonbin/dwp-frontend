{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dwp.example/schemas/widget-rollout-operation.v1.schema.json",
  "title": "DWP Widget Rollout Operations and Expiry Gate V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureVersion", "promotionGate", "examples"],
  "properties": {
    "fixtureVersion": {
      "const": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/operationExample"
      }
    },
    "promotionGate": {
      "$ref": "#/definitions/promotionGatePolicy"
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "not": {
        "pattern": "^0000-"
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "compactJws": {
      "type": "string",
      "minLength": 16,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "rolloutRevision",
        "ring",
        "ringBps",
        "clockSource",
        "evaluatedAt"
      ],
      "properties": {
        "environment": {
          "const": "STAGING"
        },
        "rolloutRevision": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "ring": {
          "enum": ["STATIC", "STAGING_BOOTSTRAP", "STAGING_SHADOW"]
        },
        "ringBps": {
          "$ref": "#/definitions/basisPoints"
        },
        "clockSource": {
          "const": "DATABASE"
        },
        "evaluatedAt": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "rolloutApprovalCreateBootstrapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "environment",
        "rolloutRevision",
        "expectedHeadVersion",
        "fromRingBps",
        "toRingBps",
        "bootstrapPrerequisite",
        "ciAttestation",
        "selectorKeyId",
        "proposerRef",
        "approverRefs",
        "expiresAt"
      ],
      "properties": {
        "kind": {
          "const": "BOOTSTRAP"
        },
        "environment": {
          "const": "STAGING"
        },
        "rolloutRevision": {
          "$ref": "#/definitions/positiveInteger"
        },
        "expectedHeadVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "selectorKeyId": {
          "$ref": "#/definitions/revision"
        },
        "proposerRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "approverRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/opaqueRef"
          }
        },
        "expiresAt": {
          "$ref": "#/definitions/timestamp"
        },
        "fromRingBps": {
          "const": 0
        },
        "toRingBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "bootstrapPrerequisite": {
          "$ref": "widget-bootstrap-prerequisite.v1.schema.json"
        },
        "ciAttestation": {
          "$ref": "#/definitions/attestationReference"
        }
      }
    },
    "rolloutApprovalCreatePromotionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "environment",
        "rolloutRevision",
        "expectedHeadVersion",
        "fromRingBps",
        "toRingBps",
        "rolloutEvidence",
        "evidenceAuthorityAttestation",
        "selectorKeyId",
        "proposerRef",
        "approverRefs",
        "expiresAt"
      ],
      "properties": {
        "kind": {
          "const": "PROMOTION"
        },
        "environment": {
          "const": "STAGING"
        },
        "rolloutRevision": {
          "$ref": "#/definitions/positiveInteger"
        },
        "expectedHeadVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "selectorKeyId": {
          "$ref": "#/definitions/revision"
        },
        "proposerRef": {
          "$ref": "#/definitions/opaqueRef"
        },
        "approverRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/opaqueRef"
          }
        },
        "expiresAt": {
          "$ref": "#/definitions/timestamp"
        },
        "fromRingBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "toRingBps": {
          "type": "integer",
          "minimum": 101,
          "maximum": 10000
        },
        "rolloutEvidence": {
          "$ref": "widget-rollout-evidence.v1.schema.json"
        },
        "evidenceAuthorityAttestation": {
          "$ref": "#/definitions/attestationReference"
        }
      }
    },
    "rolloutActivateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "approvalRevision", "expectedHeadVersion"],
      "properties": {
        "approvalId": {
          "$ref": "#/definitions/uuid"
        },
        "approvalRevision": {
          "$ref": "#/definitions/positiveInteger"
        },
        "expectedHeadVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        }
      }
    },
    "activationRuntimeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentBuildDigest",
        "migrationSetDigests",
        "catalogRevision",
        "bindingCatalogRevision",
        "policyRevision",
        "safetyRevision",
        "rolloutQuerySetRevision",
        "selectorKeyId",
        "selectorState"
      ],
      "properties": {
        "deploymentBuildDigest": {
          "$ref": "#/definitions/sha256"
        },
        "migrationSetDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "provider", "auth"],
          "properties": {
            "platform": {
              "$ref": "#/definitions/sha256"
            },
            "provider": {
              "$ref": "#/definitions/sha256"
            },
            "auth": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "catalogRevision": {
          "$ref": "#/definitions/revision"
        },
        "bindingCatalogRevision": {
          "$ref": "#/definitions/sha256"
        },
        "policyRevision": {
          "$ref": "#/definitions/revision"
        },
        "safetyRevision": {
          "oneOf": [
            {
              "$ref": "#/definitions/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "rolloutQuerySetRevision": {
          "$ref": "#/definitions/sha256"
        },
        "selectorKeyId": {
          "$ref": "#/definitions/revision"
        },
        "selectorState": {
          "const": "ACTIVE"
        }
      }
    },
    "activationSnapshotRecheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evaluatedAt",
        "evidenceDigest",
        "querySetRevision",
        "immutableSnapshotRefHash",
        "authorityVerificationRecordId"
      ],
      "properties": {
        "result": {
          "const": "SUCCESS"
        },
        "evaluatedAt": {
          "$ref": "#/definitions/timestamp"
        },
        "evidenceDigest": {
          "$ref": "#/definitions/sha256"
        },
        "querySetRevision": {
          "$ref": "#/definitions/sha256"
        },
        "immutableSnapshotRefHash": {
          "$ref": "#/definitions/sha256"
        },
        "authorityVerificationRecordId": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "trustedActivationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockedCurrentHead",
        "lockedLatestApproval",
        "headLockAffectedRows",
        "approvalLockAffectedRows",
        "currentBootstrapPrerequisiteId",
        "currentBootstrapPrerequisiteDigest",
        "currentRuntimeSnapshot",
        "currentRolloutEvidenceDigest",
        "currentEvidenceAuthorityVerificationId",
        "snapshotRecheck"
      ],
      "properties": {
        "lockedCurrentHead": {
          "$ref": "#/definitions/widgetCatalogRolloutStateResponse"
        },
        "lockedLatestApproval": {
          "$ref": "#/definitions/widgetCatalogRolloutApprovalResponse"
        },
        "headLockAffectedRows": {
          "const": 1
        },
        "approvalLockAffectedRows": {
          "const": 1
        },
        "currentBootstrapPrerequisiteId": {
          "$ref": "#/definitions/uuid"
        },
        "currentBootstrapPrerequisiteDigest": {
          "$ref": "#/definitions/sha256"
        },
        "currentRuntimeSnapshot": {
          "$ref": "#/definitions/activationRuntimeSnapshot"
        },
        "currentRolloutEvidenceDigest": {
          "oneOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentEvidenceAuthorityVerificationId": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotRecheck": {
          "oneOf": [
            {
              "$ref": "#/definitions/activationSnapshotRecheck"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "title": "Bootstrap activation context",
          "properties": {
            "currentRuntimeSnapshot": {
              "properties": {
                "safetyRevision": {
                  "type": "null"
                }
              }
            },
            "currentRolloutEvidenceDigest": {
              "type": "null"
            },
            "currentEvidenceAuthorityVerificationId": {
              "type": "null"
            },
            "snapshotRecheck": {
              "type": "null"
            }
          }
        },
        {
          "title": "Promotion activation context",
          "properties": {
            "currentRuntimeSnapshot": {
              "properties": {
                "safetyRevision": {
                  "$ref": "#/definitions/revision"
                }
              }
            },
            "currentRolloutEvidenceDigest": {
              "$ref": "#/definitions/sha256"
            },
            "currentEvidenceAuthorityVerificationId": {
              "$ref": "#/definitions/uuid"
            },
            "snapshotRecheck": {
              "$ref": "#/definitions/activationSnapshotRecheck"
            }
          }
        }
      ]
    },
    "trustedTerminalTransitionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockedCurrentHead",
        "lockedLatestApproval",
        "headLockAffectedRows",
        "approvalLockAffectedRows"
      ],
      "properties": {
        "lockedCurrentHead": {
          "$ref": "#/definitions/widgetCatalogRolloutStateResponse"
        },
        "lockedLatestApproval": {
          "$ref": "#/definitions/widgetCatalogRolloutApprovalResponse"
        },
        "headLockAffectedRows": {
          "const": 1
        },
        "approvalLockAffectedRows": {
          "const": 1
        }
      }
    },
    "rolloutStopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedHeadVersion", "reasonCode", "incidentRef"],
      "properties": {
        "expectedHeadVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "incidentRef": {
          "$ref": "#/definitions/opaqueRef"
        }
      }
    },
    "rolloutEvidenceReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId"],
      "properties": {
        "evidenceId": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "widgetCatalogRolloutApprovalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "approvalRevision",
        "kind",
        "state",
        "environment",
        "rolloutRevision",
        "fromRingBps",
        "toRingBps",
        "selectorKeyId",
        "bootstrapPrerequisiteId",
        "bootstrapPrerequisiteDigest",
        "ciAttestationJti",
        "rolloutEvidenceId",
        "rolloutEvidenceDigest",
        "evidenceAttestationJti",
        "createdAt",
        "activationDeadline",
        "expiresAt",
        "headVersion"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/definitions/uuid"
        },
        "approvalRevision": {
          "$ref": "#/definitions/positiveInteger"
        },
        "kind": {
          "enum": ["BOOTSTRAP", "PROMOTION"]
        },
        "state": {
          "enum": ["ACTIVE", "REVOKED", "EXPIRED"]
        },
        "environment": {
          "const": "STAGING"
        },
        "rolloutRevision": {
          "$ref": "#/definitions/positiveInteger"
        },
        "fromRingBps": {
          "$ref": "#/definitions/basisPoints"
        },
        "toRingBps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "selectorKeyId": {
          "$ref": "#/definitions/revision"
        },
        "bootstrapPrerequisiteId": {
          "$ref": "#/definitions/uuid"
        },
        "bootstrapPrerequisiteDigest": {
          "$ref": "#/definitions/sha256"
        },
        "ciAttestationJti": {
          "$ref": "#/definitions/uuid"
        },
        "rolloutEvidenceId": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "rolloutEvidenceDigest": {
          "oneOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceAttestationJti": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "activationDeadline": {
          "$ref": "#/definitions/timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/timestamp"
        },
        "headVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "createdAt": {
          "$ref": "#/definitions/timestamp"
        }
      },
      "oneOf": [
        {
          "title": "Bootstrap approval nullability",
          "properties": {
            "kind": {
              "const": "BOOTSTRAP"
            },
            "fromRingBps": {
              "const": 0
            },
            "toRingBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "rolloutEvidenceId": {
              "type": "null"
            },
            "rolloutEvidenceDigest": {
              "type": "null"
            },
            "evidenceAttestationJti": {
              "type": "null"
            }
          }
        },
        {
          "title": "Promotion approval nullability",
          "properties": {
            "kind": {
              "const": "PROMOTION"
            },
            "fromRingBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "toRingBps": {
              "type": "integer",
              "minimum": 101,
              "maximum": 10000
            },
            "rolloutEvidenceId": {
              "$ref": "#/definitions/uuid"
            },
            "rolloutEvidenceDigest": {
              "$ref": "#/definitions/sha256"
            },
            "evidenceAttestationJti": {
              "$ref": "#/definitions/uuid"
            }
          }
        }
      ]
    },
    "widgetCatalogRolloutStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "phase",
        "rolloutRevision",
        "headVersion",
        "ringBps",
        "selectorKeyId",
        "activeApprovalId",
        "activeApprovalRevision",
        "activeApprovalExpiresAt",
        "bootstrapPrerequisiteId",
        "bootstrapPrerequisiteDigest",
        "ciAttestationJti",
        "activeRolloutEvidenceId",
        "activeRolloutEvidenceDigest"
      ],
      "properties": {
        "environment": {
          "const": "STAGING"
        },
        "phase": {
          "enum": ["STATIC", "BOOTSTRAP", "SHADOW"]
        },
        "rolloutRevision": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "headVersion": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "ringBps": {
          "$ref": "#/definitions/basisPoints"
        },
        "selectorKeyId": {
          "oneOf": [
            {
              "$ref": "#/definitions/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeApprovalId": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeApprovalRevision": {
          "oneOf": [
            {
              "$ref": "#/definitions/positiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeApprovalExpiresAt": {
          "oneOf": [
            {
              "$ref": "#/definitions/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "bootstrapPrerequisiteId": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "bootstrapPrerequisiteDigest": {
          "oneOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "ciAttestationJti": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRolloutEvidenceId": {
          "oneOf": [
            {
              "$ref": "#/definitions/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRolloutEvidenceDigest": {
          "oneOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "title": "Static state nullability",
          "properties": {
            "phase": {
              "const": "STATIC"
            },
            "ringBps": {
              "const": 0
            },
            "selectorKeyId": {
              "type": "null"
            },
            "activeApprovalId": {
              "type": "null"
            },
            "activeApprovalRevision": {
              "type": "null"
            },
            "activeApprovalExpiresAt": {
              "type": "null"
            },
            "bootstrapPrerequisiteId": {
              "type": "null"
            },
            "bootstrapPrerequisiteDigest": {
              "type": "null"
            },
            "ciAttestationJti": {
              "type": "null"
            },
            "activeRolloutEvidenceId": {
              "type": "null"
            },
            "activeRolloutEvidenceDigest": {
              "type": "null"
            }
          }
        },
        {
          "title": "Bootstrap state nullability",
          "properties": {
            "phase": {
              "const": "BOOTSTRAP"
            },
            "ringBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "selectorKeyId": {
              "$ref": "#/definitions/revision"
            },
            "activeApprovalId": {
              "$ref": "#/definitions/uuid"
            },
            "activeApprovalRevision": {
              "$ref": "#/definitions/positiveInteger"
            },
            "activeApprovalExpiresAt": {
              "$ref": "#/definitions/timestamp"
            },
            "bootstrapPrerequisiteId": {
              "$ref": "#/definitions/uuid"
            },
            "bootstrapPrerequisiteDigest": {
              "$ref": "#/definitions/sha256"
            },
            "ciAttestationJti": {
              "$ref": "#/definitions/uuid"
            },
            "activeRolloutEvidenceId": {
              "type": "null"
            },
            "activeRolloutEvidenceDigest": {
              "type": "null"
            }
          }
        },
        {
          "title": "Shadow state nullability",
          "properties": {
            "phase": {
              "const": "SHADOW"
            },
            "ringBps": {
              "type": "integer",
              "minimum": 101,
              "maximum": 10000
            },
            "selectorKeyId": {
              "$ref": "#/definitions/revision"
            },
            "activeApprovalId": {
              "$ref": "#/definitions/uuid"
            },
            "activeApprovalRevision": {
              "$ref": "#/definitions/positiveInteger"
            },
            "activeApprovalExpiresAt": {
              "$ref": "#/definitions/timestamp"
            },
            "bootstrapPrerequisiteId": {
              "$ref": "#/definitions/uuid"
            },
            "bootstrapPrerequisiteDigest": {
              "$ref": "#/definitions/sha256"
            },
            "ciAttestationJti": {
              "$ref": "#/definitions/uuid"
            },
            "activeRolloutEvidenceId": {
              "$ref": "#/definitions/uuid"
            },
            "activeRolloutEvidenceDigest": {
              "$ref": "#/definitions/sha256"
            }
          }
        }
      ]
    },
    "widgetCatalogRolloutEvidenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceDigest",
        "rolloutRevision",
        "ring",
        "querySetRevision",
        "immutableSnapshotRefHash",
        "windowStart",
        "windowEnd",
        "verifiedAt",
        "deploymentBuildDigest",
        "catalogRevision",
        "bindingCatalogRevision",
        "policyRevision",
        "safetyRevision",
        "selectorKeyId",
        "ringBps",
        "evidenceAttestationJti"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/definitions/uuid"
        },
        "evidenceDigest": {
          "$ref": "#/definitions/sha256"
        },
        "querySetRevision": {
          "$ref": "#/definitions/sha256"
        },
        "immutableSnapshotRefHash": {
          "$ref": "#/definitions/sha256"
        },
        "windowStart": {
          "$ref": "#/definitions/timestamp"
        },
        "windowEnd": {
          "$ref": "#/definitions/timestamp"
        },
        "verifiedAt": {
