{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/schemas/widget-command-completion.v1.schema.json",
  "title": "DWP Widget Registry Command Completion V1",
  "description": "Closed durable completion response binding command identity, outcome, operation-specific public body/status/ETag, and canonical response hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "operationId",
    "commandType",
    "target",
    "outcome",
    "responseStatus",
    "responseBody",
    "responseEtag",
    "responseHash",
    "completedAt"
  ],
