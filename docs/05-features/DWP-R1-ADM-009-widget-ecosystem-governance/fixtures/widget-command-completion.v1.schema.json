      "enum": [
        "CREATE_DEFINITION",
        "CREATE_VERSION",
        "UPDATE_VERSION",
        "VALIDATE",
        "SUBMIT",
        "DECIDE",
        "REWORK",
        "RECORD_EVIDENCE",
        "WAIVE_EVIDENCE",
        "PUBLISH",
        "DEPRECATE",
        "QUARANTINE",
        "APPROVE_QUARANTINE_CLEARANCE",
        "CLEAR_QUARANTINE",
        "REVOKE",
        "RETIRE",
        "PROMOTE",
        "ROLLBACK",
        "DISABLE_RUNTIME_CONTROL",
        "APPROVE_RUNTIME_CONTROL_ENABLE",
        "ENABLE_RUNTIME_CONTROL"
      ]
    },
    "target": {
      "type": "object"
    },
    "outcome": {
      "enum": ["SUCCEEDED", "REJECTED", "NOT_EXECUTED"]
    },
    "responseStatus": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "responseBody": {
      "type": "object"
    },
    "responseEtag": {
      "oneOf": [
        {
          "$ref": "#/$defs/etag"
        },
        {
          "type": "null"
        }
      ]
    },
    "responseHash": {
      "$ref": "#/$defs/sha256"
    },
    "completedAt": {
      "$ref": "#/$defs/timestamp"
    }
