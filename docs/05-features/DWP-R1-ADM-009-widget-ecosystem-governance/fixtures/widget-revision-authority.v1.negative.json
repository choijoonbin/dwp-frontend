{
  "fixtureVersion": 1,
  "cases": [
    {
      "name": "state-change-event-outside-commit",
      "mutations": [
        {
          "operation": "SET",
          "path": "mutationCases.0.eventCount",
          "value": 0
        }
      ],
      "expectedError": "STATE_EVENT_OUTBOX_SAME_COMMIT"
    },
    {
      "name": "replay-bumps-head",
      "mutations": [
        {
          "operation": "SET",
          "path": "mutationCases.3.nextRevision",
          "value": "43"
        }
      ],
      "expectedError": "NON_MUTATION_REVISION_BUMP"
    },
    {
      "name": "no-op-emits-outbox",
      "mutations": [
        {
          "operation": "SET",
          "path": "mutationCases.4.outboxCount",
          "value": 1
        }
      ],
      "expectedError": "NON_MUTATION_SIDE_EFFECT"
    },
    {
      "name": "rollback-decrements-head",
      "mutations": [
        {
          "operation": "SET",
          "path": "mutationCases.6.nextRevision",
          "value": "11"
        }
      ],
      "expectedError": "ROLLBACK_NOT_MONOTONIC"
    },
    {
      "name": "overflow-wraps-to-zero",
      "mutations": [
        {
          "operation": "SET",
          "path": "mutationCases.7.nextRevision",
          "value": "0"
        },
        {
          "operation": "SET",
          "path": "mutationCases.7.readinessStatus",
          "value": "READY"
        }
      ],
      "expectedError": "BIGINT_OVERFLOW_FAIL_CLOSED"
    },
    {
