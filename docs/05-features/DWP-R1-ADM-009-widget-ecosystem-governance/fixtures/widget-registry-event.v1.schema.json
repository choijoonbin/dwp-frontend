{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/schemas/widget-registry-event.v1.schema.json",
  "title": "DWP Widget Registry Event V1",
  "description": "Closed event envelope for command, evidence-expiry scheduler, and shadow-observer events.",
  "oneOf": [
    { "$ref": "#/$defs/commandEvent" },
    { "$ref": "#/$defs/evidenceExpiryEvent" },
    { "$ref": "#/$defs/shadowEvaluationEvent" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectionType": {
      "type": "string",
      "enum": [
        "DefinitionState",
        "VersionState",
        "EvidenceDecision",
        "ReleaseChannelHead",
        "RuntimeControlHead",
        "TenantPolicyHead",
        "RolloutApproval",
        "RolloutHead"
      ]
    },
    "approvalState": {
      "type": "string",
      "enum": ["ACTIVE", "CONSUMED"]
    },
    "enableApprovalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "controlRevision",
        "state",
        "expiresAt",
        "consumedAt",
        "consumedByCommandId"
      ],
      "properties": {
        "approvalId": { "$ref": "#/$defs/uuid" },
        "controlRevision": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/approvalState" },
        "expiresAt": { "$ref": "#/$defs/occurredAt" },
        "consumedAt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/occurredAt" }]
        },
        "consumedByCommandId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ACTIVE" } } },
          "then": {
            "properties": {
              "consumedAt": { "type": "null" },
              "consumedByCommandId": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "CONSUMED" } } },
          "then": {
            "properties": {
              "consumedAt": { "$ref": "#/$defs/occurredAt" },
              "consumedByCommandId": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      ]
    },
    "clearanceApprovalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "quarantineEventId",
        "quarantineRevision",
        "state",
        "expiresAt",
        "consumedAt",
        "consumedByCommandId"
      ],
      "properties": {
        "approvalId": { "$ref": "#/$defs/uuid" },
        "quarantineEventId": { "$ref": "#/$defs/uuid" },
        "quarantineRevision": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/approvalState" },
        "expiresAt": { "$ref": "#/$defs/occurredAt" },
        "consumedAt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/occurredAt" }]
        },
        "consumedByCommandId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ACTIVE" } } },
          "then": {
            "properties": {
              "consumedAt": { "type": "null" },
              "consumedByCommandId": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "CONSUMED" } } },
          "then": {
            "properties": {
              "consumedAt": { "$ref": "#/$defs/occurredAt" },
              "consumedByCommandId": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      ]
    },
    "definitionStateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "state", "rowVersion"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "state": { "enum": ["ACTIVE", "RETIRED"] },
        "rowVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "versionStateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "versionId",
        "workflowState",
        "releaseState",
        "safetyState",
        "currentQuarantineEventId",
        "currentQuarantineRevision",
        "validationRunId",
        "latestClearanceApproval",
        "rowVersion"
      ],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "workflowState": {
          "enum": ["DRAFT", "SUBMITTED", "APPROVED", "REJECTED"]
        },
        "releaseState": {
          "enum": ["UNPUBLISHED", "PUBLISHED", "DEPRECATED", "REVOKED"]
        },
        "safetyState": { "enum": ["CLEAR", "QUARANTINED"] },
        "currentQuarantineEventId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "currentQuarantineRevision": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "validationRunId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "latestClearanceApproval": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/clearanceApprovalProjection" }]
        },
        "rowVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceDecisionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "versionId",
        "evidenceType",
        "status",
        "evidenceRefHash",
        "decisionRevision",
        "rowVersion"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "evidenceType": {
          "enum": ["SECURITY", "PERFORMANCE", "LOCALIZATION"]
        },
        "status": { "enum": ["PASS", "FAIL", "EXPIRED", "WAIVED"] },
        "evidenceRefHash": { "$ref": "#/$defs/sha256" },
        "decisionRevision": { "type": "integer", "minimum": 1 },
        "rowVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "releaseChannelHeadProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "channel",
        "currentVersionId",
        "previousVersionId",
        "headRevision"
      ],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "channel": { "enum": ["STABLE", "PREVIEW"] },
        "currentVersionId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "previousVersionId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "headRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "runtimeControlHeadProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlId",
        "targetType",
        "targetId",
        "state",
        "controlRevision",
        "latestEnableApproval"
      ],
      "properties": {
        "controlId": { "$ref": "#/$defs/uuid" },
        "targetType": { "enum": ["GLOBAL", "DEFINITION", "VERSION"] },
        "targetId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "state": { "enum": ["DISABLED", "ENABLED"] },
        "controlRevision": { "type": "integer", "minimum": 1 },
        "latestEnableApproval": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/enableApprovalProjection" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "targetType": { "const": "GLOBAL" } } },
          "then": { "properties": { "targetId": { "type": "null" } } }
        },
        {
          "if": {
            "properties": {
              "targetType": { "enum": ["DEFINITION", "VERSION"] }
            }
          },
          "then": { "properties": { "targetId": { "$ref": "#/$defs/uuid" } } }
        }
      ]
    },
    "tenantPolicyHeadProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantRef",
        "definitionId",
        "headRevisionId",
        "revision",
        "state",
        "impactRevision",
        "policyCatalogRevision"
      ],
      "properties": {
        "tenantRef": { "$ref": "#/$defs/tenantRef" },
        "definitionId": { "$ref": "#/$defs/uuid" },
        "headRevisionId": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["PUBLISHED", "REVOKED"] },
        "impactRevision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "policyCatalogRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "rolloutApprovalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "environment",
        "approvalRevision",
        "rolloutRevision",
        "state",
        "registryRevision",
        "tenantPolicyRevision",
        "safetyRevision"
      ],
      "properties": {
        "approvalId": { "$ref": "#/$defs/uuid" },
        "environment": { "const": "STAGING" },
        "approvalRevision": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["ACTIVE", "CONSUMED", "REVOKED", "EXPIRED"] },
        "registryRevision": { "type": "integer", "minimum": 1 },
        "tenantPolicyRevision": { "type": "integer", "minimum": 1 },
        "safetyRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "rolloutHeadProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "rolloutRevision",
        "state",
        "approvalId",
        "registryRevision",
        "tenantPolicyRevision",
        "safetyRevision"
      ],
      "properties": {
        "environment": { "const": "STAGING" },
        "rolloutRevision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["STATIC", "ACTIVE", "STOPPED"] },
        "approvalId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "registryRevision": { "type": "integer", "minimum": 1 },
        "tenantPolicyRevision": { "type": "integer", "minimum": 1 },
        "safetyRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "projectionPayload": {
      "oneOf": [
        { "$ref": "#/$defs/definitionStateProjection" },
        { "$ref": "#/$defs/versionStateProjection" },
        { "$ref": "#/$defs/evidenceDecisionProjection" },
        { "$ref": "#/$defs/releaseChannelHeadProjection" },
        { "$ref": "#/$defs/runtimeControlHeadProjection" },
        { "$ref": "#/$defs/tenantPolicyHeadProjection" },
        { "$ref": "#/$defs/rolloutApprovalProjection" },
        { "$ref": "#/$defs/rolloutHeadProjection" }
      ]
    },
    "occurredAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
        },
        { "not": { "pattern": "^0000-" } }
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "CHANNEL_PROMOTION_APPROVED",
        "CHANNEL_ROLLBACK_APPROVED",
        "DEFINITION_CONTROL_DISABLED",
        "DEFINITION_CONTROL_ENABLED",
        "DEFINITION_CREATE_APPROVED",
        "DEFINITION_RETIRE_APPROVED",
        "EVIDENCE_REVIEW_COMPLETED",
        "EVIDENCE_WAIVER_APPROVED",
        "GLOBAL_KILL_ENABLED",
        "GLOBAL_KILL_RELEASED",
        "QUARANTINE_CLEAR_EXECUTED",
        "QUARANTINE_CLEAR_REVIEWED",
        "ROLLOUT_ACTIVATED",
        "ROLLOUT_APPROVAL_EXPIRED",
        "ROLLOUT_APPROVAL_RECORDED",
        "ROLLOUT_SAFETY_STOP",
        "RUNTIME_CONTROL_ENABLE_APPROVED",
        "SECURITY_INCIDENT",
        "SECURITY_REVOKE",
        "SYSTEM_EVIDENCE_EXPIRY",
        "TENANT_POLICY_APPROVED",
        "TENANT_POLICY_REVOKED",
        "TENANT_POLICY_ROLLED_BACK",
        "VERSION_APPROVED",
        "VERSION_CONTROL_DISABLED",
        "VERSION_CONTROL_ENABLED",
        "VERSION_CREATE_APPROVED",
        "VERSION_DEPRECATED",
        "VERSION_DRAFT_UPDATED",
        "VERSION_PUBLISHED",
        "VERSION_REJECTED",
        "VERSION_REWORKED",
        "VERSION_SUBMITTED",
        "VERSION_VALIDATION_COMPLETED"
      ]
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tenantRef": {
      "type": "string",
      "minLength": 20,
      "maxLength": 124,
      "pattern": "^tnr_[a-z0-9_-]{16,120}$"
    },
    "shadowAggregateRef": {
      "type": "string",
      "minLength": 20,
      "maxLength": 124,
      "pattern": "^agg_[a-z0-9_-]{16,120}$"
    },
    "releaseChannelAggregateId": {
      "type": "string",
      "pattern": "^channel:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:(?:STABLE|PREVIEW)$"
    },
    "tenantPolicyAggregateId": {
      "type": "string",
      "pattern": "^tenant-policy:tnr_[a-z0-9_-]{16,120}:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "providerActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "auditRefHash"],
      "properties": {
        "plane": { "const": "PROVIDER" },
        "auditRefHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "tenantActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "auditRefHash"],
      "properties": {
        "plane": { "const": "TENANT" },
        "auditRefHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "deploymentControllerActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "auditRefHash"],
      "properties": {
        "plane": { "const": "DEPLOYMENT_CONTROLLER" },
        "auditRefHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "definitionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" }
      }
    },
    "versionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "versionId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" }
      }
    },
    "validationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "versionId", "validationRunId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "validationRunId": { "$ref": "#/$defs/uuid" }
      }
    },
    "evidenceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "versionId", "evidenceId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "evidenceId": { "$ref": "#/$defs/uuid" }
      }
    },
    "evidenceWaiverTarget": {
      "type": "object",
      "description": "The new waiver evidenceId MUST differ from waivedEvidenceId; the standalone verifier enforces this cross-field invariant.",
      "additionalProperties": false,
      "required": ["definitionId", "versionId", "evidenceId", "waivedEvidenceId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "evidenceId": { "$ref": "#/$defs/uuid" },
        "waivedEvidenceId": { "$ref": "#/$defs/uuid" }
      }
    },
    "clearanceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "versionId", "clearanceApprovalId", "quarantineEventId"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "clearanceApprovalId": { "$ref": "#/$defs/uuid" },
        "quarantineEventId": { "$ref": "#/$defs/uuid" }
      }
    },
    "releaseChannelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionId", "versionId", "channel"],
      "properties": {
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "channel": { "enum": ["STABLE", "PREVIEW"] }
      }
    },
    "runtimeControlGlobalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "targetType", "resultingState"],
      "properties": {
        "controlId": { "$ref": "#/$defs/uuid" },
        "targetType": { "const": "GLOBAL" },
        "resultingState": { "enum": ["DISABLED", "ENABLED"] },
        "enableApprovalId": { "$ref": "#/$defs/uuid" }
      },
      "allOf": [
        {
          "if": { "properties": { "resultingState": { "const": "ENABLED" } } },
          "then": { "required": ["enableApprovalId"] },
          "else": { "not": { "required": ["enableApprovalId"] } }
        }
      ]
    },
    "runtimeControlDefinitionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "targetType", "resultingState", "definitionId"],
      "properties": {
        "controlId": { "$ref": "#/$defs/uuid" },
        "targetType": { "const": "DEFINITION" },
        "resultingState": { "enum": ["DISABLED", "ENABLED"] },
        "definitionId": { "$ref": "#/$defs/uuid" },
        "enableApprovalId": { "$ref": "#/$defs/uuid" }
      },
      "allOf": [
        {
          "if": { "properties": { "resultingState": { "const": "ENABLED" } } },
          "then": { "required": ["enableApprovalId"] },
          "else": { "not": { "required": ["enableApprovalId"] } }
        }
      ]
    },
    "runtimeControlVersionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "targetType", "resultingState", "definitionId", "versionId"],
      "properties": {
        "controlId": { "$ref": "#/$defs/uuid" },
        "targetType": { "const": "VERSION" },
        "resultingState": { "enum": ["DISABLED", "ENABLED"] },
        "definitionId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "enableApprovalId": { "$ref": "#/$defs/uuid" }
      },
      "allOf": [
        {
          "if": { "properties": { "resultingState": { "const": "ENABLED" } } },
          "then": { "required": ["enableApprovalId"] },
          "else": { "not": { "required": ["enableApprovalId"] } }
        }
      ]
    },
    "runtimeControlTarget": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeControlGlobalTarget" },
        { "$ref": "#/$defs/runtimeControlDefinitionTarget" },
        { "$ref": "#/$defs/runtimeControlVersionTarget" }
      ]
    },
    "runtimeControlEnableApprovalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "enableApprovalId"],
      "properties": {
        "controlId": { "$ref": "#/$defs/uuid" },
        "enableApprovalId": { "$ref": "#/$defs/uuid" }
      }
    },
    "tenantPolicyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantRef", "definitionId", "policyRevisionId"],
      "properties": {
        "tenantRef": { "$ref": "#/$defs/tenantRef" },
        "definitionId": { "$ref": "#/$defs/uuid" },
        "policyRevisionId": { "$ref": "#/$defs/uuid" }
      }
    },
    "rolloutApprovalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "approvalId", "approvalRevision", "rolloutRevision"],
      "properties": {
        "environment": { "const": "STAGING" },
        "approvalId": { "$ref": "#/$defs/uuid" },
        "approvalRevision": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "rolloutActivationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "approvalId", "approvalRevision", "rolloutRevision"],
      "properties": {
        "environment": { "const": "STAGING" },
        "approvalId": { "$ref": "#/$defs/uuid" },
        "approvalRevision": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "rolloutStopTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "rolloutRevision",
        "approvalId",
        "approvalExpiresAt",
        "stopCause"
      ],
      "properties": {
        "environment": { "const": "STAGING" },
        "rolloutRevision": { "type": "integer", "minimum": 1 },
        "approvalId": { "$ref": "#/$defs/uuid" },
        "approvalExpiresAt": { "$ref": "#/$defs/occurredAt" },
        "stopCause": { "enum": ["SAFETY_THRESHOLD", "APPROVAL_EXPIRED"] }
      }
    },
    "shadowTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregateRef"],
      "properties": {
        "aggregateRef": { "$ref": "#/$defs/shadowAggregateRef" }
      }
    },
    "rolloutContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ring", "surface", "placementContext", "rolloutRevision"],
      "properties": {
        "ring": { "enum": ["staging-bootstrap", "staging-shadow"] },
        "surface": { "const": "workspace-home" },
        "placementContext": {
          "enum": ["CLASSIC_PERSONAL", "FLOW_PERSONAL", "FLOW_GOVERNED"]
        },
        "rolloutRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "commandEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "commandId",
        "eventType",
        "aggregateType",
        "aggregateId",
        "aggregateSequence",
        "occurredAt",
        "correlationId",
        "actor",
        "target",
        "reasonCode",
        "projectionSchemaVersion",
        "projectionType",
        "beforeHash",
        "afterHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "$ref": "#/$defs/uuid" },
