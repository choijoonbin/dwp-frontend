{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dwp.example/schemas/widget-manifest.v1.schema.json",
  "title": "DWP Widget Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "definitionKey",
    "owner",
    "renderer",
    "supportedSurfaces",
    "requiredAuthorities",
    "placement",
    "configurationContract",
    "dataCapabilities",
    "actionCapabilities",
    "sharing",
    "operations",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "definitionKey": { "$ref": "#/$defs/lowerKey" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productKey", "sourceAppResourceKey"],
      "properties": {
        "productKey": { "$ref": "#/$defs/lowerKey" },
        "sourceAppResourceKey": { "$ref": "#/$defs/appResourceKey" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rendererKey", "minimumHostApiVersion"],
      "properties": {
        "kind": { "const": "NATIVE" },
        "rendererKey": { "$ref": "#/$defs/lowerKey" },
        "minimumHostApiVersion": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "supportedSurfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["workspace-home"] }
    },
    "requiredAuthorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authority" }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedContexts",
        "policyClass",
        "canHide",
        "defaultSize",
        "allowedSizes",
        "defaultHeight",
        "allowedHeights"
      ],
      "properties": {
        "supportedContexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["CLASSIC_PERSONAL", "FLOW_PERSONAL", "FLOW_GOVERNED"] }
        },
        "policyClass": { "enum": ["PERSONAL", "GOVERNED"] },
        "canHide": { "type": "boolean" },
        "defaultSize": { "$ref": "#/$defs/size" },
        "allowedSizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/size" }
        },
        "defaultHeight": { "$ref": "#/$defs/height" },
        "allowedHeights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/height" }
        }
      }
    },
    "configurationContract": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKey", "fieldKeys", "filterPresets", "itemLimit"],
          "properties": {
            "sourceKey": { "$ref": "#/$defs/upperKey" },
            "fieldKeys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][A-Za-z0-9]*$"
              }
            },
            "filterPresets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/upperKey" }
            },
            "itemLimit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "integer", "minimum": 1, "maximum": 100 },
                "max": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        }
      ]
    },
    "dataCapabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/upperKey" }
    },
    "actionCapabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/upperKey" }
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presetEligible"],
      "properties": { "presetEligible": { "type": "boolean" } }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshnessSeconds", "analyticsKey"],
      "properties": {
        "freshnessSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "analyticsKey": { "$ref": "#/$defs/lowerKey" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "retention", "recipientContextBinding"],
      "properties": {
        "classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
        "retention": { "const": "NONE" },
        "recipientContextBinding": { "const": true }
      }
    }
  },
  "$defs": {
    "lowerKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "upperKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z0-9_]+)*$"
    },
    "appResourceKey": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^APP\\.[A-Z][A-Z0-9_]*(?:\\.[A-Z0-9_]+)*$"
    },
    "authority": {
      "type": "string",
      "minLength": 7,
      "maxLength": 160,
      "pattern": "^APP\\.[A-Z][A-Z0-9_.]*:[A-Z][A-Z0-9_]*$"
    },
    "size": { "enum": ["fifth", "quarter", "compact", "medium", "large", "full"] },
    "height": { "enum": ["short", "standard", "tall", "expanded"] }
  }
}
