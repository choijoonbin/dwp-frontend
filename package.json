{
  "name": "@dwp-frontend/workspace",
  "author": "DWP",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "node scripts/check-package-manager-policy.mjs && node scripts/check-feature-boundaries.mjs && node scripts/check-api-boundaries.mjs && node scripts/check-design-system-adoption.mjs && node scripts/check-i18n.mjs && node scripts/check-display-dictionary.mjs && eslint . && tsc && vite build && node scripts/check-bundle-budget.mjs",
    "bundle:check": "vite build && node scripts/check-bundle-budget.mjs",
    "lint": "node scripts/check-package-manager-policy.mjs && node scripts/check-feature-boundaries.mjs && node scripts/check-api-boundaries.mjs && eslint . && node scripts/check-design-system-adoption.mjs && node scripts/check-display-dictionary.mjs",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check \"{apps,libs,e2e,e2e-storybook,.storybook,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,json}\" \"*.{js,mjs,ts,json,md}\" \"docs/**/*.md\"",
    "format": "prettier --write \"{apps,libs,e2e,e2e-storybook,.storybook,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,json}\" \"*.{js,mjs,ts,json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/check-feature-boundaries.mjs && node scripts/check-api-boundaries.mjs",
    "package-manager:check": "node scripts/check-package-manager-policy.mjs",
    "design-system:check": "node scripts/check-design-system-adoption.mjs",
    "design-system:baseline": "node scripts/check-design-system-adoption.mjs --write",
    "i18n:check": "node scripts/check-i18n.mjs",
    "display-dictionary:check": "node scripts/check-display-dictionary.mjs",
    "release:evidence:check": "node scripts/check-release-readiness.mjs",
    "release:gate": "node scripts/check-release-readiness.mjs --release",
    "test": "vitest run",
    "test:design-system": "vitest run --config libs/design-system/vitest.config.ts",
    "test:shared-utils": "vitest run --config libs/shared-utils/vitest.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:performance": "playwright test e2e/performance-budget.spec.ts --project=chromium --workers=1",
    "test:visual": "playwright test e2e/visual.spec.ts e2e/shell-visual.spec.ts e2e/menu-visual-baseline.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts e2e/shell-visual.spec.ts e2e/menu-visual-baseline.spec.ts --update-snapshots=all",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:storybook:update": "playwright test --config playwright.storybook.config.ts --update-snapshots=all",
    "license:check": "node scripts/check-production-licenses.mjs",
    "license:report": "node scripts/check-production-licenses.mjs --write",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.12 <27"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^9.11.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@tanstack/react-query": "^5.66.6",
    "@xyflow/react": "12.11.2",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.4.1",
    "web-vitals": "6.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/expect": "4.1.10",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jsdom": "^29.0.0",
    "nx": "^22.3.3",
    "playwright-core": "1.58.0",
    "prettier": "^3.5.3",
    "storybook": "^10.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "4.1.10"
  }
}
