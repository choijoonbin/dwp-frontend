{
  "name": "@dwp-frontend/workspace",
  "author": "DWP",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check \"{apps,libs,e2e,e2e-storybook,.storybook,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,json}\" \"*.{js,mjs,ts,json,md}\" \"docs/**/*.md\"",
    "format": "prettier --write \"{apps,libs,e2e,e2e-storybook,.storybook,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,json}\" \"*.{js,mjs,ts,json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:design-system": "vitest run --config libs/design-system/vitest.config.ts",
    "test:shared-utils": "vitest run --config libs/shared-utils/vitest.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots=all",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:storybook:update": "playwright test --config playwright.storybook.config.ts --update-snapshots=all",
    "license:check": "node scripts/check-production-licenses.mjs",
    "license:report": "node scripts/check-production-licenses.mjs --write",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.17.1",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^9.11.0",
    "@tanstack/react-query": "^5.66.6",
    "i18next": "^24.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.4.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^22.19.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jsdom": "^29.0.0",
    "nx": "^22.3.3",
    "playwright-core": "1.58.0",
    "prettier": "^3.5.3",
    "storybook": "^10.5.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.5",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^4.0.18"
  }
}
